TZ=Asia/Manila
FLASK_SKIP_DOTENV=1
DATABASE_PATH=data/inventory.db
ZROK2_ENABLE_TOKEN=z1A2yBxC3d4w
ZROK2_SHARE_NAME=inventory-management
# Optional. Set to 1 (or true/yes) when the app is served behind a reverse
# proxy such as zrok, so client IPs come from X-Forwarded-For (used by login
# rate limiting). Defaults to 0.
#TRUST_PROXY=0
# Optional. Set to 1 (or true/yes) to enable Flask debug mode during
# development. Defaults to 0.
#DEBUG=0
# Optional. When unset, a random key is generated once and persisted to
# <database directory>/secret_key. Set it to share sessions across containers.
#SECRET_KEY=
