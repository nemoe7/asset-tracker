{% extends "base.jinja" %}

{% block title %}
Initial Setup
{% endblock %}

{% block content %}

<main class="min-h-screen flex items-center justify-center px-6">
  <div class="w-full max-w-md">
    <div class="bg-gray-800 rounded-xl shadow-xl p-8">
      <h1 class="text-2xl font-bold text-gray-100">
        Initial Setup
      </h1>


      <p class="mt-2 text-sm text-gray-400">
        Create the first Admin account to initialize the system.
      </p>

      {% if error %}
      <div class="mt-6 rounded-lg border border-red-800 bg-red-900/40 px-4 py-3 text-sm text-red-300">
        {{ error }}
      </div>
      {% endif %}

      <form method="post" class="mt-6 space-y-5">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-300">
            Username
          </label>

          <input id="username" name="username" type="text" required autocomplete="username" value="{{ username or '' }}"
            class="mt-2 w-full rounded-lg bg-gray-700 border border-gray-600 px-3 py-2 text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500">
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-300">
            Password
          </label>

          <input id="password" name="password" type="password" required autocomplete="new-password"
            class="mt-2 w-full rounded-lg bg-gray-700 border border-gray-600 px-3 py-2 text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500">
        </div>

        <div>
          <label for="confirm_password" class="block text-sm font-medium text-gray-300">
            Confirm Password
          </label>

          <input id="confirm_password" name="confirm_password" type="password" required autocomplete="new-password"
            class="mt-2 w-full rounded-lg bg-gray-700 border border-gray-600 px-3 py-2 text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500">
        </div>

        <button type="submit"
          class="w-full rounded-lg bg-gray-600 px-4 py-2.5 font-medium text-gray-100 hover:bg-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-400">
          Create Admin Account
        </button>
      </form>
    </div>


  </div>
</main>

{% endblock %}
