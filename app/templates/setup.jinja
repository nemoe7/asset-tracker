{% extends "base.jinja" %}

{% block title %}
Initial Setup
{% endblock %}

{% block content %}

<main class="flex min-h-screen items-center justify-center px-6">
  <div class="w-full max-w-md">
    <div class="rounded-xl border border-zinc-700 bg-zinc-800 p-8 shadow-xl">
      <h1 class="text-2xl font-bold text-zinc-100">
        Initial Setup
      </h1>

      <p class="mt-2 text-sm text-zinc-400">
        Create the first Admin account to initialize the system.
      </p>

      {% if error %}
      <div class="mt-5 rounded-lg border border-red-900/50 bg-red-950/40 px-4 py-3 text-sm text-red-300">
        {{ error }}
      </div>
      {% endif %}

      <form method="post" class="mt-6 space-y-5">
        <div>
          <label for="username" class="block text-sm font-medium text-zinc-300">
            Username
          </label>

          <input id="username" name="username" type="text" required autocomplete="username" value="{{ username or '' }}"
            class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-3 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400">
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-zinc-300">
            Password
          </label>

          <input id="password" name="password" type="password" required autocomplete="new-password"
            class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-3 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400">
        </div>

        <div>
          <label for="confirm_password" class="block text-sm font-medium text-zinc-300">
            Confirm Password
          </label>

          <input id="confirm_password" name="confirm_password" type="password" required autocomplete="new-password"
            class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-3 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400">
        </div>

        <button type="submit"
          class="w-full rounded-lg bg-zinc-100 px-4 py-2.5 font-medium text-zinc-900 hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-zinc-400">
          Create Admin Account
        </button>
      </form>
    </div>
  </div>
</main>

{% endblock %}
