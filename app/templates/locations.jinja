{% extends "base.jinja" %}

{% block title %}
Locations
{% endblock %}

{% block content %}
<main class="p-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">
      Locations
    </h1>

    <button type="button" onclick="document.getElementById('add-location-modal').showModal()"
      class="rounded-lg bg-zinc-700 px-5 py-2 font-medium text-zinc-100 hover:bg-zinc-600">
      Add Location
    </button>
  </div>

  <div class="mt-6 rounded-xl border border-zinc-700 bg-zinc-800">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-zinc-700 text-zinc-400">
          <tr>
            <th class="whitespace-nowrap px-4 py-3 font-medium">
              ID
            </th>

            <th class="w-full px-4 py-3 font-medium">
              Name
            </th>

            <th class="whitespace-nowrap px-4 py-3 font-medium">
              Actions
            </th>
          </tr>
        </thead>

        <tbody class="divide-y divide-zinc-700">
          {% for location in locations %}
          <tr class="hover:bg-zinc-700/40">
            <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-zinc-400">
              {{ location.id }}
            </td>

            <td class="px-4 py-3 font-medium">
              {{ location.name }}
            </td>

            <td class="whitespace-nowrap px-4 py-3">
              <button type="button" onclick="document.getElementById('edit-location-{{ location.id }}').showModal()"
                class="rounded-lg px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-700 hover:text-zinc-100">
                Edit
              </button>
            </td>
          </tr>

          {% else %}
          <tr>
            <td colspan="3" class="px-4 py-10 text-center text-zinc-500">
              No locations found.
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</main>

<dialog id="add-location-modal"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Add Location
      </h2>

      <button type="button" onclick="document.getElementById('add-location-modal').close()"
        class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    <form method="post" action="{{ url_for('locations.create') }}" class="mt-6 space-y-5">
      <div>
        <label for="location-name" class="block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="location-name" name="name" type="text" required autofocus
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
      </div>

      <div class="flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('add-location-modal').close()"
          class="rounded-lg border border-zinc-600 px-4 py-2 text-zinc-300 hover:bg-zinc-700">
          Cancel
        </button>

        <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
          Create Location
        </button>
      </div>
    </form>
  </div>
</dialog>

{% for location in locations %}
<dialog id="edit-location-{{ location.id }}"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Edit Location
      </h2>

      <button type="button" onclick="document.getElementById('edit-location-{{ location.id }}').close()"
        class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    <form method="post" action="{{ url_for('locations.update', location_id=location.id) }}" class="mt-6 space-y-5">
      <div>
        <label for="edit-location-name-{{ location.id }}" class="block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="edit-location-name-{{ location.id }}" name="name" type="text" value="{{ location.name }}" required
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
      </div>

      <div class="flex items-center justify-between pt-2">
        <button type="submit" formaction="{{ url_for('locations.delete', location_id=location.id) }}" name="confirm"
          value="1" onclick="return confirm('Delete this location?')"
          class="rounded-lg px-4 py-2 text-sm text-red-400 hover:bg-red-950/50 hover:text-red-300">
          Delete
        </button>

        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('edit-location-{{ location.id }}').close()"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-zinc-300 hover:bg-zinc-700">
            Cancel
          </button>

          <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
            Save Changes
          </button>
        </div>
      </div>
    </form>
  </div>
</dialog>
{% endfor %}
{% endblock %}
