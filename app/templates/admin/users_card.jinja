<div class="px-4 py-4 hover:bg-zinc-700/40">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="font-medium text-zinc-100">
        {{ user.username }}

        {% if user.id == session.get("user_id") %}
        <span class="ml-2 text-xs text-zinc-500">
          You
        </span>
        {% endif %}
      </div>

      <div class="mt-1 text-sm text-zinc-300">
        {% if user.roles %}
        {{ user.roles|join(", ") }}
        {% else %}
        <span class="text-zinc-500">
          No roles
        </span>
        {% endif %}
      </div>

      <div class="mt-1 text-xs text-zinc-400">
        Created {{ user.created_at|datetime }}
      </div>

      <div class="mt-1 text-xs">
        {% if user.archived_at %}
        <span class="text-red-400">
          Archived
        </span>
        {% else %}
        <span class="text-green-400">
          Active
        </span>
        {% endif %}
      </div>
    </div>

    <button type="button" onclick="document.getElementById('edit-user-{{ user.id }}').showModal()"
      class="shrink-0 rounded-lg px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-700 hover:text-zinc-100">
      Edit
    </button>
  </div>
</div>
