{# Activity (audit log) tab panel, included from admin/settings.jinja. #}

{% from "admin/_audit_items.jinja" import desktop_row, mobile_card %}
{% from "shared/_modal.jinja" import modal %}

<section id="tab-audit" data-tab-panel="audit" class="{{ 'hidden' if active_tab != 'audit' }}">

  <h2 class="mb-4 text-lg font-semibold">Activity</h2>

  {# ==================== Filter Toolbar ==================== #}
  <div class="mb-4 flex flex-wrap items-center gap-2">

    <button type="button" id="audit-filter-button" aria-haspopup="dialog"
      class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950 sm:w-auto">
      <i class="bi bi-sliders mr-1" aria-hidden="true"></i>
      Filter
    </button>

    {# ==================== Active Filter Chips ==================== #}
    {% if chips %}
    <div class="flex flex-wrap items-center gap-2">
      {% for chip in chips %}
      <a href="{{ chip['remove_url'] }}" data-filter-chip
        class="rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100"
        aria-label="{{ chip['label'] }} — remove filter">
        {{ chip['label'] | e }}
        <i class="bi bi-x-lg ml-2" aria-hidden="true"></i>
      </a>
      {% endfor %}

      <a href="{{ url_for('admin.settings', tab='audit') }}" data-filter-clear
        class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-400 transition hover:text-zinc-200"
        aria-label="Clear all filters">
        Clear all
      </a>
    </div>
    {% endif %}
    {# ==================== End Active Filter Chips ==================== #}

    <p id="audit-count" data-shown="{{ logs | length }}" data-total="{{ total }}"
      class="ml-auto text-sm text-zinc-400">
      Showing {{ logs | length }} of {{ total }} events
    </p>

  </div>
  {# ==================== End Filter Toolbar ==================== #}


  {# ==================== Activity List ==================== #}
  <section class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900">

    {# Desktop Table #}
    <div class="hidden overflow-x-auto md:block">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-zinc-800">
          <tr>
            <th class="px-5 py-3 font-medium text-zinc-400">Timestamp</th>
            <th class="px-5 py-3 font-medium text-zinc-400">User</th>
            <th class="px-5 py-3 font-medium text-zinc-400">Action</th>
            <th class="px-5 py-3 font-medium text-zinc-400">Entity type</th>
            <th class="px-5 py-3 font-medium text-zinc-400">Entity ID</th>
            <th class="px-5 py-3 font-medium text-zinc-400">Details</th>
          </tr>
        </thead>
        <tbody id="audit-rows-desktop" class="divide-y divide-zinc-800">
          {% for log in logs %}
          {{ desktop_row(log) }}
          {% endfor %}
          {% if not logs %}
          <tr>
            <td colspan="6" class="px-5 py-8 text-center text-sm text-zinc-500">
              No activity found.
            </td>
          </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    {# Mobile Cards #}
    <div id="audit-rows-mobile" class="divide-y divide-zinc-800 md:hidden">
      {% for log in logs %}
      {{ mobile_card(log) }}
      {% endfor %}
      {% if not logs %}
      <p class="px-4 py-8 text-center text-sm text-zinc-500">
        No activity found.
      </p>
      {% endif %}
    </div>

  </section>
  {# ==================== End Activity List ==================== #}


  {# ==================== Load More / End ==================== #}
  <div class="mt-6 text-center">
    {% if has_more %}
    <a id="audit-load-more"
      href="{{ url_for('admin.settings', tab='audit', page=page + 1, **filters) }}"
      class="inline-block rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
      Load more
    </a>
    <div id="audit-sentinel" data-has-more="true" data-next-page="{{ page + 1 }}"
      class="h-px w-full" aria-hidden="true"></div>
    {% else %}
    <p id="audit-end" class="text-sm text-zinc-500">End of activity &middot; {{ total }} events</p>
    {% endif %}
  </div>
  {# ==================== End Load More / End ==================== #}


  {# ==================== Filter Modal ==================== #}
  {% call modal("filter-audit-modal", "Filter activity") %}
  <form id="audit-filter-form" method="get" action="{{ url_for('admin.settings', tab='audit') }}">
    {# GET forms replace the action's query string, so the tab is kept via a field. #}
    <input type="hidden" name="tab" value="audit">
    <div class="space-y-5">

      <fieldset>
        <label for="audit-filter-entity-type" class="mb-2 block text-sm font-medium text-zinc-300">Entity type</label>
        <div class="relative">
          <select id="audit-filter-entity-type" name="entity_type" class="form-select">
            <option value="">All</option>
            {% for entity_type in entity_types %}
            <option value="{{ entity_type | e }}" {{ 'selected' if filters['entity_type'] == entity_type }}>
              {{ entity_type | e }}
            </option>
            {% endfor %}
          </select>
          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>
        </div>
      </fieldset>

      <fieldset>
        <label for="audit-filter-action" class="mb-2 block text-sm font-medium text-zinc-300">Action</label>
        <div class="relative">
          <select id="audit-filter-action" name="action" class="form-select">
            <option value="">All</option>
            {% for action in actions %}
            <option value="{{ action | e }}" {{ 'selected' if filters['action'] == action }}>
              {{ action | e }}
            </option>
            {% endfor %}
          </select>
          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>
        </div>
      </fieldset>

      <fieldset>
        <label for="audit-filter-user" class="mb-2 block text-sm font-medium text-zinc-300">User</label>
        <div class="relative">
          <select id="audit-filter-user" name="user_id" class="form-select">
            <option value="">All</option>
            {% for user in users %}
            <option value="{{ user['id'] }}" {{ 'selected' if filters['user_id'] == user['id']|string }}>
              {{ user['username'] | e }}
            </option>
            {% endfor %}
          </select>
          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>
        </div>
      </fieldset>

      <fieldset>
        <label for="audit-filter-entity-id" class="mb-2 block text-sm font-medium text-zinc-300">Entity ID</label>
        <input id="audit-filter-entity-id" name="entity_id" type="text" value="{{ filters['entity_id'] | e }}"
          class="form-input">
      </fieldset>

      <div class="grid gap-4 sm:grid-cols-2">
        <fieldset>
          <label for="audit-filter-from" class="mb-2 block text-sm font-medium text-zinc-300">From</label>
          <input id="audit-filter-from" name="from" type="date" value="{{ filters['from'] | e }}" class="form-input">
        </fieldset>

        <fieldset>
          <label for="audit-filter-to" class="mb-2 block text-sm font-medium text-zinc-300">To</label>
          <input id="audit-filter-to" name="to" type="date" value="{{ filters['to'] | e }}" class="form-input">
        </fieldset>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <a href="{{ url_for('admin.settings', tab='audit') }}"
          class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Clear
        </a>

        <button type="submit"
          class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
          Apply
        </button>
      </div>

    </div>
  </form>
  {% endcall %}
  {# ==================== End Filter Modal ==================== #}

</section>
