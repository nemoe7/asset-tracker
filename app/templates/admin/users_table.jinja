<tr class="hover:bg-zinc-700/40">
  <td class="px-4 py-3 font-medium text-zinc-100">
    {{ user.username }}

    {% if user.id == session.get("user_id") %}
    <span class="ml-2 text-xs text-zinc-500">
      You
    </span>
    {% endif %}
  </td>

  <td class="px-4 py-3 text-zinc-300">
    {% if user.roles %}
    {{ user.roles|join(", ") }}
    {% else %}
    <span class="text-zinc-500">
      No roles
    </span>
    {% endif %}
  </td>

  <td class="px-4 py-3 text-zinc-400">
    {{ user.created_at|datetime }}
  </td>

  <td class="px-4 py-3">
    {% if user.archived_at %}
    <span class="text-red-400">
      Archived
    </span>
    {% else %}
    <span class="text-green-400">
      Active
    </span>
    {% endif %}
  </td>

  <td class="px-4 py-3 text-right">
    <button type="button" onclick="document.getElementById('edit-user-{{ user.id }}').showModal()"
      class="rounded-lg px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-700 hover:text-zinc-100">
      Edit
    </button>
  </td>
</tr>
