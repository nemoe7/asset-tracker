{% extends "base.jinja" %}

{% from "shared/_modal.jinja" import modal %}

{% block title %}Astra - Management{% endblock %}

{% block body %}

{# ==================== Admin Page ==================== #}
<div class="min-h-screen bg-zinc-950 text-zinc-100">

  {# ==================== Header ==================== #}
  <header class="border-b border-zinc-800 bg-zinc-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

      <div class="flex items-center gap-4">

        <a href="{{ url_for('main.index') }}"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          <i class="bi bi-arrow-left mr-1" aria-hidden="true"></i>
          Assets
        </a>

        <h1 class="text-xl font-semibold tracking-tight">
          Management
        </h1>

      </div>

      <div class="flex items-center gap-3">

        {# ==================== Menu ==================== #}
        <details class="relative">

          <summary class="icon-button cursor-pointer list-none">
            <i class="bi bi-list block text-xl" aria-hidden="true"></i>
            <span class="sr-only">Open menu</span>
          </summary>

          <div
            class="absolute right-0 top-full z-50 mt-2 min-w-40 rounded-lg border border-zinc-800 bg-zinc-900 p-1 shadow-xl">

            <div class="px-3 py-2 text-sm text-zinc-400">
              @{{ session.username }}
            </div>

            <a href="{{ url_for('admin.settings') }}"
              class="block rounded-md px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100">
              <i class="bi bi-gear mr-1" aria-hidden="true"></i>
              Admin Panel
            </a>

            <form method="post" action="{{ url_for('auth.logout') }}">
              <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
              <button type="submit"
                class="block w-full rounded-md px-3 py-2 text-left text-sm text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100">
                <i class="bi bi-box-arrow-right mr-1" aria-hidden="true"></i>
                Log out
              </button>
            </form>

          </div>

        </details>
        {# ==================== End Menu ==================== #}

      </div>

    </div>
  </header>
  {# ==================== End Header ==================== #}


  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    {# ==================== Error ==================== #}
    {% if error %}
    <p class="mb-6 rounded-lg border border-red-800 bg-red-950 px-3 py-2 text-sm text-red-300">
      {{ error }}
    </p>
    {% endif %}
    {# ==================== End Error ==================== #}


    {# ==================== Tabs ==================== #}
    <div id="admin-tabs" class="mb-6 flex gap-1">

      {% if can_manage_locations %}
      <button type="button" data-tab-button="locations"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Locations
      </button>
      {% endif %}

      {% if can_manage_custom_fields %}
      <button type="button" data-tab-button="custom-fields"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Custom fields
      </button>
      {% endif %}

      <button type="button" data-tab-button="data"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Data
      </button>

      {% if can_view_audit %}
      <button type="button" data-tab-button="audit"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Activity
      </button>
      {% endif %}

      {% if can_manage_users %}
      <button type="button" data-tab-button="users"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Users
      </button>
      {% endif %}

      {% if can_manage_roles %}
      <button type="button" data-tab-button="roles"
        class="admin-tab rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100">
        Roles
      </button>
      {% endif %}

    </div>
    {# ==================== End Tabs ==================== #}


    {# ==================== Locations Panel ==================== #}
    {% if can_manage_locations %}
    <section id="tab-locations" data-tab-panel="locations" class="{{ 'hidden' if active_tab != 'locations' }}">

      {# ==================== Add Location ==================== #}
      <div class="mb-6 flex justify-end">
        <button type="button" id="add-location-button"
          class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
          <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
          Add location
        </button>
      </div>

      {% call modal("add-location-dialog", "Add location") %}
      <form method="post" action="{{ url_for('admin.create_location_route') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div class="mt-4">
          <label for="add-location-name" class="mb-2 block text-sm font-medium text-zinc-300">Name</label>
          <input id="add-location-name" name="name" type="text" required value="{{ location_name or '' }}"
            class="form-input">
        </div>

        <div class="mt-4">
          <label for="add-location-description" class="mb-2 block text-sm font-medium text-zinc-300">Description</label>
          <input id="add-location-description" name="description" type="text" value="{{ location_description or '' }}"
            class="form-input">
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-add-location"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>
          <button type="submit"
            class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
            <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
            Add location
          </button>
        </div>
      </form>
      {% endcall %}
      {# ==================== End Add Location ==================== #}


      {# ==================== Edit Location ==================== #}
      {% call modal("edit-location-dialog", "Edit location") %}
      <form method="post" action="">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div>
          <label for="edit-location-name" class="mb-2 block text-sm font-medium text-zinc-300">Name</label>
          <input id="edit-location-name" name="name" type="text" required class="form-input">
        </div>

        <div class="mt-4">
          <label for="edit-location-description"
            class="mb-2 block text-sm font-medium text-zinc-300">Description</label>
          <input id="edit-location-description" name="description" type="text" class="form-input">
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-edit-location"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>
          <button type="submit"
            class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
            <i class="bi bi-pencil mr-1" aria-hidden="true"></i>
            Save changes
          </button>
        </div>
      </form>
      {% endcall %}
      {# ==================== End Edit Location ==================== #}


      {# ==================== Locations List ==================== #}
      {% if locations %}
      <section class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900">

        {# Desktop Table #}
        <div class="hidden overflow-x-auto md:block">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-zinc-800">
              <tr>
                <th class="px-5 py-3 font-medium text-zinc-400">Name</th>
                <th class="px-5 py-3 font-medium text-zinc-400">Description</th>
                <th class="w-px whitespace-nowrap px-5 py-3 text-center font-medium text-zinc-400">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
              {% for location in locations %}
              <tr>
                <td class="px-5 py-4 font-medium text-zinc-100">
                  <div class="flex items-center gap-3">
                    <span class="truncate" title="{{ location.name }}">{{ location.name }}</span>
                  </div>
                </td>
                <td class="px-5 py-4 text-zinc-400">
                  {{ location.description or '—' }}
                </td>
                <td class="px-5 py-4">
                  <div class="flex justify-end gap-1">
                    <button type="button"
                      class="edit-location rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                      data-location-id="{{ location.id }}" data-location-name="{{ location.name }}"
                      data-location-description="{{ location.description or '' }}"
                      data-update-url="{{ url_for('admin.update_location_route', location_id=location.id) }}"
                      title="Edit location" aria-label="Edit location">
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <form method="post" action="{{ url_for('admin.delete_location_route', location_id=location.id) }}"
                      data-delete-location>
                      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                      <input type="hidden" name="confirm" value="true">
                      <button type="submit"
                        class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
                        title="Delete location" aria-label="Delete location">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {# Mobile Cards #}
        <div class="divide-y divide-zinc-800 md:hidden">
          {% for location in locations %}
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="flex min-w-0 items-center gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-zinc-100">{{ location.name }}</p>
                {% if location.description %}
                <p class="truncate text-xs text-zinc-400">{{ location.description }}</p>
                {% endif %}
              </div>
            </div>
            <div class="flex shrink-0 gap-1">
              <button type="button"
                class="edit-location rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                data-location-id="{{ location.id }}" data-location-name="{{ location.name }}"
                data-location-description="{{ location.description or '' }}"
                data-update-url="{{ url_for('admin.update_location_route', location_id=location.id) }}"
                title="Edit location" aria-label="Edit location">
                <i class="bi bi-pencil" aria-hidden="true"></i>
              </button>
              <form method="post" action="{{ url_for('admin.delete_location_route', location_id=location.id) }}"
                data-delete-location>
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="confirm" value="true">
                <button type="submit" class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
                  title="Delete location" aria-label="Delete location">
                  <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
              </form>
            </div>
          </div>
          {% endfor %}
        </div>

      </section>
      {% else %}
      <section class="rounded-xl border border-dashed border-zinc-800 bg-zinc-900/50 px-6 py-16 text-center">
        <i class="bi bi-geo-alt text-3xl text-zinc-600" aria-hidden="true"></i>
        <h2 class="mt-4 text-lg font-medium text-zinc-200">No locations</h2>
        <p class="mt-2 text-sm text-zinc-400">Add your first location to get started.</p>
        <button type="button" id="empty-add-location-button"
          class="mt-6 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
          <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
          Add location
        </button>
      </section>
      {% endif %}
      {# ==================== End Locations List ==================== #}

    </section>
    {% endif %}
    {# ==================== End Locations Panel ==================== #}


    {# ==================== Custom Fields Panel ==================== #}
    {% if can_manage_custom_fields %}
    <section id="tab-custom-fields" data-tab-panel="custom-fields"
      class="{{ 'hidden' if active_tab != 'custom-fields' }}">

      {# ==================== Add Custom Field ==================== #}
      <div class="mb-6 flex justify-end">
        <button type="button" id="add-field-button"
          class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
          <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
          Add field
        </button>
      </div>

      {% call modal("add-field-dialog", "Add custom field") %}
      <form method="post" action="{{ url_for('admin.create_custom_field_route') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div>
          <label for="add-field-name" class="mb-2 block text-sm font-medium text-zinc-300">Name</label>
          <input id="add-field-name" name="name" type="text" required value="{{ field_name or '' }}" class="form-input">
        </div>

        <div class="mt-4">
          <label for="add-field-type" class="mb-2 block text-sm font-medium text-zinc-300">Type</label>

          <select id="add-field-type" name="field_type" data-enum-toggle class="form-input">
            <option value="text" {{ 'selected' if field_type=='text' }}>Text</option>
            <option value="integer" {{ 'selected' if field_type=='integer' }}>Integer</option>
            <option value="decimal" {{ 'selected' if field_type=='decimal' }}>Decimal</option>
            <option value="boolean" {{ 'selected' if field_type=='boolean' }}>Boolean</option>
            <option value="date" {{ 'selected' if field_type=='date' }}>Date</option>
            <option value="enum" {{ 'selected' if field_type=='enum' }}>Enum</option>
            <option value="user" {{ 'selected' if field_type=='user' }}>User</option>
          </select>
        </div>

        <div class="mt-4">
          <label for="add-field-description" class="mb-2 block text-sm font-medium text-zinc-300">Description</label>
          <input id="add-field-description" name="description" type="text" value="{{ field_description or '' }}"
            class="form-input">
        </div>

        <div class="mt-4 flex items-center gap-3">
          <input id="add-field-required" name="required" type="checkbox" value="true" {{ 'checked' if field_required }}
            class="size-4 rounded border-zinc-600 bg-zinc-900 text-zinc-100 focus:ring-zinc-500">

          <label for="add-field-required" class="text-sm font-medium text-zinc-300">
            Required
          </label>
        </div>

        <div class="mt-4" data-enum-values>
          <label for="add-field-enum-values" class="mb-2 block text-sm font-medium text-zinc-300">
            Enum values
          </label>

          <textarea id="add-field-enum-values" name="enum_values" rows="4" placeholder="One value per line"
            class="form-input !resize-y">{{ field_enum_values or '' }}</textarea>

          <p class="mt-1 text-xs text-zinc-500">
            Define the allowed values for this Enum field, one per line.
          </p>
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-add-field"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>

          <button type="submit"
            class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
            <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
            Add field
          </button>
        </div>
      </form>
      {% endcall %}
      {# ==================== End Add Custom Field ==================== #}


      {# ==================== Edit Custom Field ==================== #}
      {% call modal("edit-field-dialog", "Edit custom field") %}
      <form method="post" action="">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div>
          <label for="edit-field-name" class="mb-2 block text-sm font-medium text-zinc-300">Name</label>
          <input id="edit-field-name" name="name" type="text" required class="form-input">
        </div>

        <div class="mt-4">
          <label for="edit-field-type" class="mb-2 block text-sm font-medium text-zinc-300">Type</label>

          <select id="edit-field-type" name="field_type" data-enum-toggle class="form-input">
            <option value="text">Text</option>
            <option value="integer">Integer</option>
            <option value="decimal">Decimal</option>
            <option value="boolean">Boolean</option>
            <option value="date">Date</option>
            <option value="enum">Enum</option>
            <option value="user">User</option>
          </select>
        </div>

        <div class="mt-4">
          <label for="edit-field-description" class="mb-2 block text-sm font-medium text-zinc-300">Description</label>
          <input id="edit-field-description" name="description" type="text" class="form-input">
        </div>

        <div class="mt-4 flex items-center gap-3">
          <input id="edit-field-required" name="required" type="checkbox" value="true"
            class="size-4 rounded border-zinc-600 bg-zinc-900 text-zinc-100 focus:ring-zinc-500">

          <label for="edit-field-required" class="text-sm font-medium text-zinc-300">
            Required
          </label>
        </div>

        <div class="mt-4" data-enum-values>
          <label for="edit-field-enum-values" class="mb-2 block text-sm font-medium text-zinc-300">
            Enum values
          </label>

          <textarea id="edit-field-enum-values" name="enum_values" rows="4" placeholder="One value per line"
            class="form-input !resize-y"></textarea>

          <p class="mt-1 text-xs text-zinc-500">
            Define the allowed values for this Enum field, one per line.
          </p>
        </div>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-edit-field"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>

          <button type="submit"
            class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
            <i class="bi bi-pencil mr-1" aria-hidden="true"></i>
            Save changes
          </button>
        </div>
      </form>
      {% endcall %}
      {# ==================== End Edit Custom Field ==================== #}


      {# ==================== Custom Fields List ==================== #}
      {% if custom_fields %}
      <section class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900">

        {# Desktop Table #}
        <div class="hidden overflow-x-auto md:block">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-zinc-800">
              <tr>
                <th class="px-5 py-3 font-medium text-zinc-400">Name</th>
                <th class="w-px whitespace-nowrap px-5 py-3 font-medium text-zinc-400">Type</th>
                <th class="w-px whitespace-nowrap px-5 py-3 font-medium text-zinc-400">Required</th>
                <th class="w-px whitespace-nowrap px-5 py-3 text-center font-medium text-zinc-400">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
              {% for field in custom_fields %}
              <tr>
                <td class="px-5 py-4 font-medium text-zinc-100">
                  <div class="flex items-center gap-3">
                    <div class="min-w-0">
                      <span class="block truncate" title="{{ field.name }}">{{ field.name }}</span>

                      {% if field.description %}
                      <span class="block truncate text-xs font-normal text-zinc-500" title="{{ field.description }}">
                        {{ field.description }}
                      </span>
                      {% endif %}
                    </div>
                  </div>
                </td>
                <td class="px-5 py-4">
                  <span
                    class="rounded border border-zinc-700 px-1.5 py-0.5 text-[10px] uppercase tracking-wide text-zinc-400">
                    {{ field.field_type }}
                  </span>
                </td>
                <td class="px-5 py-4 text-zinc-400">
                  {% if field.required %}
                  <i class="bi bi-check-lg text-zinc-300" aria-hidden="true"></i>
                  <span class="sr-only">Yes</span>
                  {% else %}
                  <i class="bi bi-x-lg text-zinc-500" aria-hidden="true"></i>
                  <span class="sr-only">No</span>
                  {% endif %}
                </td>
                <td class="px-5 py-4">
                  <div class="flex justify-end gap-1">
                    <button type="button"
                      class="edit-field rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                      data-field-id="{{ field.id }}" data-field-name="{{ field.name }}"
                      data-field-type="{{ field.field_type }}" data-field-description="{{ field.description or '' }}"
                      data-field-required="{{ 'true' if field.required else 'false' }}"
                      data-field-enum-values="{{ field.enum_values | join('\n') if field.enum_values else '' }}"
                      data-update-url="{{ url_for('admin.update_custom_field_route', field_id=field.id) }}"
                      title="Edit custom field" aria-label="Edit custom field">
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <form method="post" action="{{ url_for('admin.archive_custom_field_route', field_id=field.id) }}"
                      data-archive-field>
                      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                      <button type="submit"
                        class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
                        title="Archive custom field" aria-label="Archive custom field">
                        <i class="bi bi-archive" aria-hidden="true"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {# Mobile Cards #}
        <div class="divide-y divide-zinc-800 md:hidden">
          {% for field in custom_fields %}
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="flex min-w-0 items-center gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <p class="truncate text-sm font-medium text-zinc-100">{{ field.name }}</p>
                  <span
                    class="shrink-0 rounded border border-zinc-700 px-1.5 py-0.5 text-[10px] uppercase tracking-wide text-zinc-400">
                    {{ field.field_type }}
                  </span>
                </div>

                {% if field.description %}
                <p class="truncate text-xs text-zinc-500">{{ field.description }}</p>
                {% endif %}
              </div>
            </div>
            <div class="flex shrink-0 gap-1">
              <button type="button"
                class="edit-field rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                data-field-id="{{ field.id }}" data-field-name="{{ field.name }}"
                data-field-type="{{ field.field_type }}" data-field-description="{{ field.description or '' }}"
                data-field-required="{{ 'true' if field.required else 'false' }}"
                data-field-enum-values="{{ field.enum_values | join('\n') if field.enum_values else '' }}"
                data-update-url="{{ url_for('admin.update_custom_field_route', field_id=field.id) }}"
                title="Edit custom field" aria-label="Edit custom field">
                <i class="bi bi-pencil" aria-hidden="true"></i>
              </button>
