                  {{ role.description or '—' }}
                </td>
                <td class="px-5 py-4">
                  {% set perms = role.permissions %}
                  {% if perms %}
                    {% for permission in perms %}
                    <span
                      class="mr-1 inline-block rounded border border-zinc-700 px-1.5 py-0.5 text-[10px] uppercase tracking-wide {{ 'text-emerald-400' if permission.allowed else 'text-red-400' }}">
                      {{ permission.permission }}
                    </span>
                    {% endfor %}
                  {% else %}
                    <span class="text-xs text-zinc-500">—</span>
                  {% endif %}
                </td>
                <td class="px-5 py-4">
                  <div class="flex justify-end gap-1">
                    <button type="button"
                      class="edit-role rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                      data-role-id="{{ role.id }}" data-role-name="{{ role.name }}"
                      data-role-description="{{ role.description or '' }}"
                      data-update-url="{{ url_for('admin.update_role_route', role_id=role.id) }}"
                      title="Edit role" aria-label="Edit role">
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    {% if not is_role_assigned(role.id) and not is_admin_role(role.id) %}
                    <form method="post" action="{{ url_for('admin.delete_role_route', role_id=role.id) }}"
                      data-delete-role>
                      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                      <button type="submit"
                        class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
                        title="Delete role" aria-label="Delete role">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                      </button>
                    </form>
                    {% endif %}
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {# Mobile Cards #}
        <div class="divide-y divide-zinc-800 md:hidden">
          {% for role in roles_with_permissions %}
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <div class="flex min-w-0 items-center gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-zinc-100">{{ role.name }}</p>
                {% if role.description %}
                <p class="truncate text-xs text-zinc-400">{{ role.description }}</p>
                {% endif %}
              </div>
            </div>
            <div class="flex shrink-0 gap-1">
              <button type="button"
                class="edit-role rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                data-role-id="{{ role.id }}" data-role-name="{{ role.name }}"
                data-role-description="{{ role.description or '' }}"
                data-update-url="{{ url_for('admin.update_role_route', role_id=role.id) }}"
                title="Edit role" aria-label="Edit role">
                <i class="bi bi-pencil" aria-hidden="true"></i>
              </button>
              {% if not is_role_assigned(role.id) and not is_admin_role(role.id) %}
              <form method="post" action="{{ url_for('admin.delete_role_route', role_id=role.id) }}"
                data-delete-role>
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
                  title="Delete role" aria-label="Delete role">
                  <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
              </form>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>

      </section>
      {% else %}
      <section class="rounded-xl border border-dashed border-zinc-800 bg-zinc-900/50 px-6 py-16 text-center">
        <i class="bi bi-shield-check text-3xl text-zinc-600" aria-hidden="true"></i>
        <h2 class="mt-4 text-lg font-medium text-zinc-200">No roles</h2>
        <p class="mt-2 text-sm text-zinc-400">Add your first role to get started.</p>
        <button type="button" id="empty-add-role-button"
          class="mt-6 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
          <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
          Add role
        </button>
      </section>
      {% endif %}
      {# ==================== End Roles List ==================== #}

          </section>
    {% endif %}
    {# ==================== End Roles Panel ==================== #}


    {# ==================== Data Panel ==================== #}
    <section id="tab-data" data-tab-panel="data" class="{{ 'hidden' if active_tab != 'data' }}">

      {# ==================== CSV/XLSX ==================== #}
      <h2 class="text-lg font-semibold">CSV/XLSX</h2>

      <div class="mt-3 rounded-xl border border-zinc-800 bg-zinc-900/50">
        <table class="w-full text-left">
          <tbody class="divide-y divide-zinc-800">
            <tr>
              <th scope="row" class="px-6 py-5 align-top font-normal">
                <span class="block text-sm font-medium text-zinc-100">Import</span>
                <span class="mt-1 block text-sm text-zinc-400">
                  Import asset records from a CSV&nbsp;or&nbsp;.xlsx file. A unique
                  Asset ID is generated for every row; each row requires at
                  least a <code class="text-zinc-300">name</code> column.
                </span>
                <p id="import-status" aria-live="polite" class="mt-2 hidden text-sm"></p>
              </th>
              <td class="px-6 py-5 text-right align-middle">
                <button type="button" id="import-button"
                  class="min-w-40 shrink-0 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                  <i class="bi bi-upload mr-1" aria-hidden="true"></i>
                  Import assets
                </button>
              </td>
            </tr>

            <tr>
              <th scope="row" class="px-6 py-5 align-top font-normal">
                <span class="block text-sm font-medium text-zinc-100">Export</span>
                <span class="mt-1 block text-sm text-zinc-400">
                  Export assets to a CSV&nbsp;file. Choose specific columns or
                  leave the selection empty to include all fields.
                </span>
              </th>
              <td class="px-6 py-5 text-right align-middle">
                <button type="button" id="export-button"
                  class="min-w-40 shrink-0 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                  <i class="bi bi-download mr-1" aria-hidden="true"></i>
                  Export CSV
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      {# ==================== End CSV/XLSX ==================== #}

      {% if can_manage_backups %}
      {# ==================== Backup ==================== #}
      <h2 class="mt-6 text-lg font-semibold">Backup</h2>

      <div class="mt-3 rounded-xl border border-zinc-800 bg-zinc-900/50">
        <table class="w-full text-left">
          <tbody class="divide-y divide-zinc-800">
            <tr>
              <th scope="row" class="px-6 py-5 align-top font-normal">
                <span class="block text-sm font-medium text-zinc-100">Manual backup</span>
                <span class="mt-1 block text-sm text-zinc-400">
                  Download a full snapshot of the application database. Backups
                  are delivered directly to you and are never stored on the
                  server.
                </span>
                <p id="backup-status" aria-live="polite" class="mt-2 hidden text-sm"></p>
              </th>
              <td class="px-6 py-5 text-right align-middle">
                <button type="button" id="backup-button"
                  class="min-w-40 shrink-0 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                  <i class="bi bi-download mr-1" aria-hidden="true"></i>
                  Download backup
                </button>
              </td>
            </tr>

            <tr>
              <th scope="row" class="px-6 py-5 align-top font-normal">
                <span class="block text-sm font-medium text-zinc-100">Restore from backup</span>
                <span class="mt-1 block text-sm text-red-300">
                  Restoring a backup overwrites <strong>all current data</strong> —
                  assets, custom fields, users, and audit history. This cannot
                  be undone. Download a fresh backup first if you are unsure.
                </span>
              </th>
              <td class="px-6 py-5 align-top">
                <form id="restore-form" class="flex flex-col items-end gap-3">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

                  <label for="restore-file" class="sr-only">
                    Backup file
                  </label>

                  <input id="restore-file" name="file" type="file" accept=".db" class="sr-only">

                  <button type="button" id="restore-choose-button"
                    class="min-w-40 truncate rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                    <i class="bi bi-upload mr-1" aria-hidden="true"></i>
                    <span id="restore-choose-label">Choose backup file…</span>
                  </button>

                  <p id="restore-status" aria-live="polite" class="hidden text-sm"></p>

                  <button type="submit" id="restore-button"
                    class="min-w-40 shrink-0 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                    <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i>
                    Restore backup
                  </button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      {# ==================== End Backup ==================== #}
      {% endif %}

      {% if debug %}
      {# ==================== Danger ==================== #}
      <h2 class="mt-6 text-lg font-semibold">Danger</h2>

      <div class="mt-3 rounded-xl border border-red-900/50 bg-zinc-900/50">
        <table class="w-full text-left">
          <tbody class="divide-y divide-red-900/30">
            <tr>
              <th scope="row" class="px-6 py-5 align-top font-normal">
                <span class="block text-sm font-medium text-zinc-100">Reset database</span>
                <span class="mt-1 block text-sm text-red-300">
                  Reset the entire database to a clean state. All assets, custom
                  fields, users, and audit history will be permanently deleted.
                  This cannot be undone. Only available when DEBUG is enabled.
                </span>
                <p id="reset-status" aria-live="polite" class="mt-2 hidden text-sm"></p>
              </th>
              <td class="px-6 py-5 text-right align-middle">
                <button type="button" id="reset-database-button"
                  class="min-w-40 shrink-0 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
                  <i class="bi bi-trash mr-1" aria-hidden="true"></i>
                  Reset database
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      {# ==================== End Danger ==================== #}
      {% endif %}

      {% include "inventory/modals/import.jinja" %}
      {% include "inventory/modals/export.jinja" %}

    </section>
    {# ==================== End Data Panel ==================== #}


    {# ==================== Activity Panel ==================== #}
    {% if can_view_audit %}
    {% include "admin/_audit_panel.jinja" %}
    {% endif %}
    {# ==================== End Activity Panel ==================== #}


    {# ==================== Restore Backup Confirmation ==================== #}
    <div id="restore-confirm-dialog" class="hidden p-6">

      <div class="flex items-start gap-4">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
          <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        </div>

        <div>
          <h2 class="text-lg font-semibold">
            Restore backup?
          </h2>

          <p class="mt-1 text-sm text-zinc-400">
            Restoring overwrites all current data. Enter your password to confirm.
          </p>
        </div>

      </div>

      <form id="restore-confirm-form" class="mt-6">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="restore-confirm-password" class="mb-2 block text-sm font-medium text-zinc-300">
          Confirm your password
        </label>

        <input id="restore-confirm-password" name="password" type="password" required autocomplete="current-password"
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

        <p id="restore-confirm-status" class="mt-2 hidden text-sm"></p>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-restore-confirm"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>

          <button type="submit" id="restore-confirm-button"
            class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
            <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i>
            Restore backup
          </button>
        </div>
      </form>

    </div>
    {# ==================== End Restore Backup Confirmation ==================== #}


    {# ==================== Delete Location Confirmation ==================== #}
    <div id="delete-location-dialog" class="hidden p-6">

      <div class="flex items-start gap-4">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
          <i class="bi bi-trash" aria-hidden="true"></i>
        </div>

        <div>
          <h2 class="text-lg font-semibold">
            Delete location?
          </h2>

          <p class="mt-1 text-sm text-zinc-400">
            Assets stored at this location will be set to no location.
          </p>
        </div>

      </div>

      <div class="mt-6 flex justify-end gap-3">
        <button type="button" id="cancel-delete-location"
          class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Cancel
        </button>

        <button type="button" id="confirm-delete-location"
          class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
          <i class="bi bi-trash mr-1" aria-hidden="true"></i>
          Delete location
        </button>
      </div>

    </div>
    {# ==================== End Delete Location Confirmation ==================== #}


    {# ==================== Archive Custom Field Confirmation ==================== #}
    <div id="archive-field-dialog" class="hidden p-6">

      <div class="flex items-start gap-4">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
          <i class="bi bi-archive" aria-hidden="true"></i>
        </div>

        <div>
          <h2 class="text-lg font-semibold">
            Archive custom field?
          </h2>

          <p class="mt-1 text-sm text-zinc-400">
            The field will be hidden from assets forms. Existing values are kept and the field can be restored.
          </p>
        </div>

      </div>

      <div class="mt-6 flex justify-end gap-3">
        <button type="button" id="cancel-archive-field"
          class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Cancel
        </button>

        <button type="button" id="confirm-archive-field"
          class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
          <i class="bi bi-archive mr-1" aria-hidden="true"></i>
          Archive field
        </button>
      </div>

    </div>
    {# ==================== End Archive Custom Field Confirmation ==================== #}

    {% if debug %}
    {# ==================== Reset Database Confirmation ==================== #}
    <div id="reset-database-dialog" class="hidden p-6">

      <div class="flex items-start gap-4">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
          <i class="bi bi-trash" aria-hidden="true"></i>
        </div>

        <div>
          <h2 class="text-lg font-semibold">
            Reset database?
          </h2>

          <p class="mt-1 text-sm text-zinc-400">
            This will permanently delete all data. Enter your password to confirm.
          </p>
        </div>

      </div>

      <form id="reset-database-form" class="mt-6 space-y-4">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div>
          <label for="reset-password" class="mb-2 block text-sm font-medium text-zinc-300">
            Password
          </label>

          <input id="reset-password" name="password" type="password" required autocomplete="current-password"
            class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
        </div>

        <div>
          <label for="reset-confirm-password" class="mb-2 block text-sm font-medium text-zinc-300">
            Confirm password
          </label>

          <input id="reset-confirm-password" name="confirm_password" type="password" required autocomplete="current-password"
            class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
        </div>

        <p id="reset-confirm-status" class="hidden text-sm"></p>

        <div class="mt-6 flex justify-end gap-3">
          <button type="button" id="cancel-reset-database"
            class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Cancel
          </button>

          <button type="submit" id="confirm-reset-database"
            class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
            <i class="bi bi-trash mr-1" aria-hidden="true"></i>
            Reset database
          </button>
        </div>
      </form>

    </div>
    {# ==================== End Reset Database Confirmation ==================== #}
    {% endif %}

  </main>
</div>
{# ==================== End Admin Page ==================== #}

{% endblock %}
{# ==================== End Body Block ==================== #}


{% block scripts %}
<script src="{{ url_for('static', filename='js/modal-manager.js') }}"></script>
<script src="{{ url_for('static', filename='js/settings.js') }}"></script>
<script src="{{ url_for('static', filename='js/data.js') }}"></script>
<script src="{{ url_for('static', filename='js/audit.js') }}"></script>
{% endblock %}
{# ==================== End Scripts Block ==================== #}
