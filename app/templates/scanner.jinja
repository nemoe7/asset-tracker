{% extends "base.jinja" %}

{% block title %}
QR Scanner
{% endblock %}

{% block content %}
<h1>Scan QR Code</h1>

<div id="reader"></div>

<form id="qr-form" action="{{ url_for('scanner.qrcode') }}" method="post">
  <input type="hidden" name="value" id="qr-value" />
</form>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>
  const form = document.getElementById("qr-form");
  const qrValue = document.getElementById("qr-value");

  const scanner = new Html5Qrcode("reader");

  scanner
    .start(
      { facingMode: "environment" },
      {
        fps: 10,
        qrbox: {
          width: 250,
          height: 250,
        },
      },
      (decodedText) => {
        qrValue.value = decodedText;

        scanner.stop().then(() => {
          form.submit();
        });
      },
      () => {
        // Ignore failed frames.
      },
    )
    .catch((error) => {
      console.error(error);
    });
</script>
{% endblock %}
