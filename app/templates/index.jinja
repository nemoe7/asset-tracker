{% extends "base.jinja" %}

{% block title %}
Inventory
{% endblock %}

{% block content %}
<main class="p-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold">
        Inventory
      </h1>

      <button type="button" onclick="document.getElementById('qr-scanner-modal').showModal(); startQrScanner()"
        class="rounded-lg bg-zinc-700 px-4 py-2 text-sm font-medium text-zinc-100 hover:bg-zinc-600 md:hidden">
        Scan QR
      </button>
    </div>

    <div class="relative">
      <details class="group">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full bg-zinc-700 text-sm font-semibold text-zinc-100 hover:bg-zinc-600"
          title="{{ username }}">
          {{ username[0]|upper }}
        </summary>

        <div class="absolute right-0 z-10 mt-2 w-48 rounded-xl border border-zinc-700 bg-zinc-800 p-2 shadow-xl">
          <div class="border-b border-zinc-700 px-3 py-2">
            <p class="truncate text-sm font-medium text-zinc-100">
              {{ username }}
            </p>
          </div>

          <form method="post" action="{{ url_for('auth.logout') }}" class="mt-2">
            <button type="submit"
              class="w-full rounded-lg px-3 py-2 text-left text-sm text-zinc-300 hover:bg-zinc-700 hover:text-zinc-100">
              Log out
            </button>
          </form>
        </div>
      </details>
    </div>
  </div>

  <div class="mt-6 md:hidden">
    <div class="rounded-xl border border-zinc-700 bg-zinc-800">
      <div class="border-b border-zinc-700 p-4">
        <form method="get" class="flex gap-3">
          <input type="search" name="search" value="{{ search }}" placeholder="Search inventory..."
            class="w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400">

          <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
            Search
          </button>
        </form>
      </div>

      <div class="divide-y divide-zinc-700">
        {% for item in items %}
        <div class="px-4 py-4 hover:bg-zinc-700/40">
          <div class="font-medium text-zinc-100">
            {{ item.name }}
          </div>

          <div class="mt-1 text-sm text-zinc-300">
            {{ item.location_name or "—" }}
          </div>

          <div class="mt-1 text-xs text-zinc-400">
            Updated {{ item.updated_at|datetime }}
          </div>
        </div>
        {% else %}
        <div class="px-4 py-10 text-center text-zinc-500">
          No inventory items found.
        </div>
        {% endfor %}
      </div>

      <div class="flex items-center justify-between border-t border-zinc-700 p-4">
        <span class="text-sm text-zinc-400">
          Page {{ page }} of {{ total_pages }}
        </span>

        <div class="flex gap-2">
          {% if page > 1 %}
          <a href="?page={{ page - 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Previous
          </a>
          {% endif %}

          {% if page < total_pages %} <a href="?page={{ page + 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Next
            </a>
            {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 hidden md:block">
    <div class="rounded-xl border border-zinc-700 bg-zinc-800">
      <div class="border-b border-zinc-700 p-4">
        <div class="flex gap-3">
          <form method="get" class="flex flex-1 gap-3">
            <input type="search" name="search" value="{{ search }}" placeholder="Search inventory..."
              class="w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400">

            <button type="submit" class="rounded-lg bg-zinc-100 px-5 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
              Search
            </button>
          </form>

          <button type="button" onclick="document.getElementById('add-item-modal').showModal()"
            class="rounded-lg bg-zinc-700 px-5 py-2 font-medium text-zinc-100 hover:bg-zinc-600">
            Add Item
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full table-auto text-left text-sm">
          <thead class="border-b border-zinc-700 text-zinc-400">
            <tr>
              <th class="whitespace-nowrap px-4 py-3 font-medium">
                ID
              </th>

              <th class="w-full px-4 py-3 font-medium">
                Name
              </th>

              <th class="max-w-64 px-4 py-3 font-medium">
                Location
              </th>

              <th class="whitespace-nowrap px-4 py-3 font-medium">
                Updated
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-zinc-700">
            {% for item in items %}
            <tr class="hover:bg-zinc-700/40">
              <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-zinc-400">
                {{ item.id }}
              </td>

              <td class="px-4 py-3 font-medium">
                {{ item.name }}
              </td>

              <td class="max-w-64 truncate px-4 py-3 text-zinc-300">
                {{ item.location_name or "—" }}
              </td>

              <td class="whitespace-nowrap px-4 py-3 text-zinc-400">
                {{ item.updated_at|datetime }}
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="4" class="px-4 py-10 text-center text-zinc-500">
                No inventory items found.
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between border-t border-zinc-700 p-4">
        <span class="text-sm text-zinc-400">
          Page {{ page }} of {{ total_pages }}
        </span>

        <div class="flex gap-2">
          {% if page > 1 %}
          <a href="?page={{ page - 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Previous
          </a>
          {% endif %}

          {% if page < total_pages %} <a href="?page={{ page + 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Next
            </a>
            {% endif %}
        </div>
      </div>
    </div>
  </div>
</main>

<dialog id="qr-scanner-modal"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Scan QR Code
      </h2>

      <button type="button" onclick="closeQrScanner()" class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    <div class="mt-5 overflow-hidden rounded-xl bg-black">
      <video id="qr-video" class="aspect-square w-full object-cover" autoplay playsinline>
      </video>
    </div>

    <p id="qr-scanner-status" class="mt-4 text-center text-sm text-zinc-400">
      Point your camera at an inventory QR code.
    </p>
  </div>
</dialog>

<dialog id="add-item-modal"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Add Item
      </h2>

      <button type="button" onclick="document.getElementById('add-item-modal').close()"
        class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    {% if error %}
    <div class="mt-4 rounded-lg border border-red-900 bg-red-950/50 px-4 py-3 text-sm text-red-300">
      {{ error }}
    </div>
    {% endif %}

    <form method="post" action="{{ url_for('inventory.create') }}" class="mt-6 space-y-5">
      <div>
        <label for="item-name" class="block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="item-name" name="name" type="text" value="{{ name or '' }}" required autofocus
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
      </div>

      <div class="flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('add-item-modal').close()"
          class="rounded-lg border border-zinc-600 px-4 py-2 text-zinc-300 hover:bg-zinc-700">
          Cancel
        </button>

        <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
          Create Item
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  let qrStream = null;
  let qrAnimationFrame = null;

  async function startQrScanner() {
    const video = document.getElementById("qr-video");
    const status = document.getElementById("qr-scanner-status");

    try {
      qrStream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: {
            ideal: "environment"
          }
        },
        audio: false
      });

      video.srcObject = qrStream;
      await video.play();

      status.textContent = "Point your camera at an inventory QR code.";

      scanQrFrame();
    } catch (error) {
      console.error(error);
      status.textContent = "Unable to access the camera.";
    }
  }

  function scanQrFrame() {
    const video = document.getElementById("qr-video");

    if (!qrStream || video.readyState < 2) {
      qrAnimationFrame = requestAnimationFrame(scanQrFrame);
      return;
    }

    if (!window.BarcodeDetector) {
      document.getElementById("qr-scanner-status").textContent =
        "QR scanning is not supported by this browser.";
      return;
    }

    const detector = new BarcodeDetector({
      formats: ["qr_code"]
    });

    detector.detect(video)
      .then((barcodes) => {
        if (barcodes.length === 0) {
          qrAnimationFrame = requestAnimationFrame(scanQrFrame);
          return;
        }

        const value = barcodes[0].rawValue;

        if (!value) {
          qrAnimationFrame = requestAnimationFrame(scanQrFrame);
          return;
        }

        stopQrScanner();

        window.location.href =
          "{{ url_for('main.index') }}" + "?id=" +
          encodeURIComponent(value);
      })
      .catch(() => {
        qrAnimationFrame = requestAnimationFrame(scanQrFrame);
      });
  }

  function stopQrScanner() {
    if (qrAnimationFrame !== null) {
      cancelAnimationFrame(qrAnimationFrame);
      qrAnimationFrame = null;
    }

    if (qrStream) {
      qrStream.getTracks().forEach((track) => track.stop());
      qrStream = null;
    }

    const video = document.getElementById("qr-video");

    if (video) {
      video.srcObject = null;
    }
  }

  function closeQrScanner() {
    stopQrScanner();
    document.getElementById("qr-scanner-modal").close();
  }

  document
    .getElementById("qr-scanner-modal")
    .addEventListener("close", stopQrScanner);
</script>

{% if error %}
<script>
  document.getElementById("add-item-modal").showModal();
</script>
{% endif %}
{% endblock %}
