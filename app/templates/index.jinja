{% extends "base.jinja" %}

{% block title %}
Inventory
{% endblock %}

{% block content %}
<main class="p-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">
      Inventory
    </h1>

    <div class="relative">
      <details class="group">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full bg-zinc-700 text-sm font-semibold text-zinc-100 hover:bg-zinc-600"
          title="{{ username }}">
          {{ username[0]|upper }}
        </summary>

        <div class="absolute right-0 z-10 mt-2 w-48 rounded-xl border border-zinc-700 bg-zinc-800 p-2 shadow-xl">
          <div class="border-b border-zinc-700 px-3 py-2">
            <p class="truncate text-sm font-medium text-zinc-100">
              {{ username }}
            </p>
          </div>

          <form method="post" action="{{ url_for('auth.logout') }}" class="mt-2">
            <button type="submit"
              class="w-full rounded-lg px-3 py-2 text-left text-sm text-zinc-300 hover:bg-zinc-700 hover:text-zinc-100">
              Log out
            </button>
          </form>
        </div>
      </details>
    </div>
  </div>

  <div class="mt-6 md:hidden">
    Mobile presentation
  </div>

  <div class="mt-6 hidden md:block">
    <div class="rounded-xl border border-zinc-700 bg-zinc-800">

      <div class="border-b border-zinc-700 p-4">
        <div class="flex gap-3">
          <form method="get" class="flex flex-1 gap-3">
            <input type="search" name="search" value="{{ search }}" placeholder="Search inventory..."
              class="w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400">

            <button type="submit" class="rounded-lg bg-zinc-100 px-5 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
              Search
            </button>
          </form>

          <button type="button" onclick="document.getElementById('add-item-modal').showModal()"
            class="rounded-lg bg-zinc-700 px-5 py-2 font-medium text-zinc-100 hover:bg-zinc-600">
            Add Item
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full table-auto text-left text-sm">
          <thead class="border-b border-zinc-700 text-zinc-400">
            <tr>
              <th class="whitespace-nowrap px-4 py-3 font-medium">
                ID
              </th>

              <th class="w-full px-4 py-3 font-medium">
                Name
              </th>

              <th class="max-w-64 px-4 py-3 font-medium">
                Location
              </th>

              <th class="whitespace-nowrap px-4 py-3 font-medium">
                Updated
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-zinc-700">
            {% for item in items %}
            <tr class="cursor-pointer hover:bg-zinc-700/40"
              onclick="document.getElementById('edit-item-{{ item.id }}').showModal()">
              <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-zinc-400">
                <div class="flex items-center gap-2">
                  <span>{{ item.id }}</span>

                  <button type="button" title="Copy ID" onclick="event.stopPropagation(); copyItemId('{{ item.id }}')"
                    class="rounded p-1 text-zinc-500 hover:bg-zinc-700 hover:text-zinc-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 4h8a2 2 0 012 2v6a2 2 0 01-2 2h-8a2 2 0 01-2-2v-6a2 2 0 012-2z" />
                    </svg>
                  </button>
                </div>
              </td>

              <td class="px-4 py-3 font-medium">
                {{ item.name }}
              </td>

              <td class="max-w-64 truncate px-4 py-3 text-zinc-300">
                {{ item.location_name or "—" }}
              </td>

              <td class="whitespace-nowrap px-4 py-3 text-zinc-400">
                {{ item.updated_at|datetime }}
              </td>
            </tr>

            {% else %}
            <tr>
              <td colspan="4" class="px-4 py-10 text-center text-zinc-500">
                No inventory items found.
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between border-t border-zinc-700 p-4">
        <span class="text-sm text-zinc-400">
          Page {{ page }} of {{ total_pages }}
        </span>

        <div class="flex gap-2">
          {% if page > 1 %}
          <a href="?page={{ page - 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Previous
          </a>
          {% endif %}

          {% if page < total_pages %} <a href="?page={{ page + 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Next
            </a>
            {% endif %}
        </div>
      </div>

    </div>
  </div>
</main>

<!-- Add Item Modal -->
<dialog id="add-item-modal"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Add Item
      </h2>

      <button type="button" onclick="document.getElementById('add-item-modal').close()"
        class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    {% if error %}
    <div class="mt-4 rounded-lg border border-red-900 bg-red-950/50 px-4 py-3 text-sm text-red-300">
      {{ error }}
    </div>
    {% endif %}

    <form method="post" action="{{ url_for('inventory.create') }}" class="mt-6 space-y-5">
      <div>
        <label for="item-name" class="block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="item-name" name="name" type="text" value="{{ name or '' }}" required autofocus
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
      </div>

      <div>
        <label for="item-location" class="block text-sm font-medium text-zinc-300">
          Location
        </label>

        <select id="item-location" name="location_id"
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
          <option value="">
            No location
          </option>

          {% for location in locations %}
          <option value="{{ location.id }}">
            {{ location.name }}
          </option>
          {% endfor %}
        </select>
      </div>

      <div class="flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('add-item-modal').close()"
          class="rounded-lg border border-zinc-600 px-4 py-2 text-zinc-300 hover:bg-zinc-700">
          Cancel
        </button>

        <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
          Create Item
        </button>
      </div>
    </form>
  </div>
</dialog>

<!-- Edit Item Modals -->
{% for item in items %}
<dialog id="edit-item-{{ item.id }}"
  class="w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">
        Edit Item
      </h2>

      <button type="button" onclick="document.getElementById('edit-item-{{ item.id }}').close()"
        class="text-2xl text-zinc-400 hover:text-zinc-100">
        &times;
      </button>
    </div>

    <p class="mt-2 font-mono text-xs text-zinc-500">
      {{ item.id }}
    </p>

    <form method="post" action="{{ url_for('inventory.update', item_id=item.id) }}" class="mt-6 space-y-5">
      <div>
        <label for="edit-name-{{ item.id }}" class="block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="edit-name-{{ item.id }}" name="name" type="text" value="{{ item.name }}" required
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
      </div>

      <div>
        <label for="edit-location-{{ item.id }}" class="block text-sm font-medium text-zinc-300">
          Location
        </label>

        <select id="edit-location-{{ item.id }}" name="location_id"
          class="mt-2 w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 outline-none focus:border-zinc-400">
          <option value="">
            No location
          </option>

          {% for location in locations %}
          <option value="{{ location.id }}" {% if item.location_id==location.id %}selected{% endif %}>
            {{ location.name }}
          </option>
          {% endfor %}
        </select>
      </div>

      <div class="flex items-center justify-between pt-2">
        <button type="submit" formaction="{{ url_for('inventory.archive', item_id=item.id) }}"
          class="rounded-lg px-4 py-2 text-sm text-red-400 hover:bg-red-950/50 hover:text-red-300">
          Archive
        </button>

        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('edit-item-{{ item.id }}').close()"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-zinc-300 hover:bg-zinc-700">
            Cancel
          </button>

          <button type="submit" class="rounded-lg bg-zinc-100 px-4 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
            Save Changes
          </button>
        </div>
      </div>
    </form>
  </div>
</dialog>
{% endfor %}

<!-- Copy Toast -->
<div id="copy-toast"
  class="pointer-events-none fixed left-1/2 top-6 z-50 -translate-x-1/2 -translate-y-4 rounded-lg border border-zinc-700 bg-zinc-800 px-4 py-2 text-sm text-zinc-100 opacity-0 shadow-xl transition-all duration-200">
  ID copied
</div>

<script>
  let copyToastTimeout;

  function copyItemId(id) {
    navigator.clipboard.writeText(id);

    const toast = document.getElementById("copy-toast");

    clearTimeout(copyToastTimeout);

    toast.classList.remove("-translate-y-4", "opacity-0");
    toast.classList.add("translate-y-0", "opacity-100");

    copyToastTimeout = setTimeout(() => {
      toast.classList.remove("translate-y-0", "opacity-100");
      toast.classList.add("-translate-y-4", "opacity-0");
    }, 1500);
  }
</script>

{% if error %}
<script>
  document.getElementById("add-item-modal").showModal();
</script>
{% endif %}
{% endblock %}
