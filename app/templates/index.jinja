{% extends "base.jinja" %}

{% block title %}
Inventory
{% endblock %}

{% block content %}
<main class="p-6">
  <h1 class="text-2xl font-bold">
    Inventory
  </h1>

  <div class="mt-6 md:hidden">
    Mobile presentation
  </div>

  <div class="mt-6 hidden md:block">
    <div class="rounded-xl border border-zinc-700 bg-zinc-800">

      <div class="border-b border-zinc-700 p-4">
        <form method="get" class="flex gap-3">
          <input type="search" name="search" value="{{ search }}" placeholder="Search inventory..."
            class="w-full rounded-lg border border-zinc-600 bg-zinc-900 px-4 py-2 text-zinc-100 placeholder-zinc-500 outline-none focus:border-zinc-400">

          <button type="submit" class="rounded-lg bg-zinc-100 px-5 py-2 font-medium text-zinc-900 hover:bg-zinc-200">
            Search
          </button>
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-zinc-700 text-zinc-400">
            <tr>
              <th class="px-4 py-3 font-medium">ID</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Location</th>
              <th class="px-4 py-3 font-medium">Updated</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-zinc-700">
            {% for item in items %}
            <tr class="hover:bg-zinc-700/40">
              <td class="px-4 py-3 font-mono text-xs text-zinc-400">
                {{ item.id }}
              </td>

              <td class="px-4 py-3 font-medium">
                {{ item.name }}
              </td>

              <td class="px-4 py-3 text-zinc-300">
                {{ item.location_name or "—" }}
              </td>

              <td class="px-4 py-3 text-zinc-400">
                {{ item.updated_at }}
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="4" class="px-4 py-10 text-center text-zinc-500">
                No inventory items found.
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between border-t border-zinc-700 p-4">
        <span class="text-sm text-zinc-400">
          Page {{ page }} of {{ total_pages }}
        </span>

        <div class="flex gap-2">
          {% if page > 1 %}
          <a href="?page={{ page - 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Previous
          </a>
          {% endif %}

          {% if page < total_pages %} <a href="?page={{ page + 1 }}&search={{ search }}"
            class="rounded-lg border border-zinc-600 px-4 py-2 text-sm hover:bg-zinc-700">
            Next
            </a>
            {% endif %}
        </div>
      </div>

    </div>
  </div>
</main>
{% endblock %}
