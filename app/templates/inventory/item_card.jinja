<div class="px-4 py-4 hover:bg-zinc-700/40">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="truncate font-medium text-zinc-100">
        {{ item.name }}
      </div>

      <div class="mt-1 truncate text-sm text-zinc-300">
        {{ item.location_name or "—" }}
      </div>

      <div class="mt-1 truncate text-xs text-zinc-400">
        Updated {{ item.updated_at|datetime }}
      </div>
    </div>

    <div class="flex shrink-0 gap-1">
      <button type="button" title="Copy ID" onclick="copyItemId('{{ item.id }}')"
        class="rounded-lg p-2 text-zinc-500 hover:bg-zinc-700 hover:text-zinc-200">

        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 4h8a2 2 0 012 2v6a2 2 0 012 2h-8a2 2 0 01-2-2v-6a2 2 0 012-2z" />
        </svg>
      </button>

      <button type="button" title="Edit item" onclick="openEditItem('{{ item.id }}')"
        class="rounded-lg p-2 text-zinc-500 hover:bg-zinc-700 hover:text-zinc-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.5-8.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 8.5-8.5z" />
        </svg>
      </button>
    </div>
  </div>
</div>
