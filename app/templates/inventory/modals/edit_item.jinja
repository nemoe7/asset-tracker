{% from "inventory/modals/_modal.jinja" import modal %}

{% set subtitle %}
<p id="edit-item-id" class="min-w-0 max-w-full truncate font-mono text-xs text-zinc-500 sm:text-sm">
</p>
{% endset %}

{% set buttons %}
<button type="submit" form="edit-item-form"
  class="![font:initial] rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
  title="Save changes" aria-label="Save changes">
  <i class="bi bi-floppy block size-4" aria-hidden="true"></i>
</button>

<button type="button" id="archive-item-button"
  class="![font:initial] rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300"
  title="Archive asset" aria-label="Archive asset">
  <i class="bi bi-archive block size-4" aria-hidden="true"></i>
</button>
{% endset %}


{% call modal("edit-item-modal", "Edit Item", subtitle, buttons) %}

<form id="edit-item-form" method="post">
  {# ==================== Edit Asset Fields ==================== #}
  <div class="overflow-hidden rounded-lg border border-zinc-800">

    <table class="w-full text-left text-sm">

      <tbody class="divide-y divide-zinc-800">

        {# Name #}
        <tr>
          <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
            Name
          </th>

          <td class="px-4 py-3">
            <input id="edit-item-name" name="name" type="text" required
              class="block w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
          </td>
        </tr>

        {# Location #}
        <tr>
          <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
            Location
          </th>

          <td class="px-4 py-3">

            <div class="relative">

              <select id="edit-item-location" name="location_id"
                class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

                <option value="">
                  —
                </option>

              </select>

              <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
                aria-hidden="true"></i>

            </div>

          </td>
        </tr>

      </tbody>

    </table>

  </div>
  {# ==================== End Edit Asset Fields ==================== #}

</form>

{% endcall %}
