{% from "inventory/modals/_modal.jinja" import modal %}

{% call modal("manage-locations-modal", "Manage Locations") %}

<div class="space-y-5">

  {# ==================== Manage Locations Error ==================== #}
  <p id="manage-locations-error"
    class="hidden rounded-lg border border-red-800 bg-red-950 px-3 py-2 text-sm text-red-300">
  </p>
  {# ==================== End Manage Locations Error ==================== #}


  {# ==================== Add Location Form ==================== #}
  <form id="add-location-form" class="space-y-4">

    <div>
      <label for="add-location-name" class="mb-2 block text-sm font-medium text-zinc-300">
        Name
      </label>

      <input id="add-location-name" name="name" type="text" required class="form-input">
    </div>

    <div>
      <label for="add-location-description" class="mb-2 block text-sm font-medium text-zinc-300">
        Description
      </label>

      <textarea id="add-location-description" name="description" rows="2"
        class="form-input !resize-none overflow-hidden min-h-10"></textarea>
    </div>

    <div class="flex justify-end">

      <button type="submit"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-900">
        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add location
      </button>

    </div>

  </form>
  {# ==================== End Add Location Form ==================== #}


  <hr class="border-zinc-800">


  {# ==================== Locations List ==================== #}
  <div id="manage-locations-list" class="space-y-2">
  </div>
  {# ==================== End Locations List ==================== #}

</div>

{% endcall %}
{# ==================== End Manage Locations Modal ==================== #}


{% call modal("delete-location-modal", title=None) %}

{# ==================== Delete Location Confirmation ==================== #}
<div class="flex items-start gap-4">

  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
    <i class="bi bi-trash" aria-hidden="true"></i>
  </div>

  <div>
    <h2 class="text-lg font-semibold">
      Delete location?
    </h2>

    <p class="mt-1 text-sm text-zinc-400">
      This will delete <span id="delete-location-name" class="font-medium text-zinc-200"></span>.
      Inventory items at this location will be set to no location.
    </p>
  </div>

</div>
{# ==================== End Delete Location Confirmation ==================== #}


{# ==================== Delete Location Actions ==================== #}
<div class="mt-6 flex justify-end gap-3">

  <button type="button" id="cancel-delete-location"
    class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
    Cancel
  </button>

  <button type="button" id="confirm-delete-location"
    class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
    <i class="bi bi-trash mr-1" aria-hidden="true"></i>
    Delete location
  </button>

</div>
{# ==================== End Delete Location Actions ==================== #}

{% endcall %}
{# ==================== End Delete Location Modal ==================== #}
