{% macro modal(id, title=None, subtitle=None, buttons=None) %}
<div id="{{ id }}" class="hidden p-6">

  {# ==================== Modal Header ==================== #}
  {% if title %}
  <div class="flex items-center justify-between gap-4">

    <div class="min-w-0">
      <h2 class="text-lg font-semibold">
        {{ title }}
      </h2>

      {% if subtitle %} {{ subtitle }} {% endif %}
    </div>

    {# Header Actions #}
    <div class="flex shrink-0 gap-1">
      {% if buttons %} {{ buttons }} {% endif %}

      <button type="button" class="icon-button modal-close" title="Close" aria-label="Close">
        <i class="bi bi-x-lg block size-4" aria-hidden="true"></i>
      </button>
    </div>

  </div>
  <div class="py-4">
    <hr class="border-zinc-800">
  </div>
  {% endif %}
  {# ==================== End Modal Header ==================== #}

  {{ caller() }}
</div>
{% endmacro %}
