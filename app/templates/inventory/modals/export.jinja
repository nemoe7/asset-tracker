{% from "shared/_modal.jinja" import modal %}

{% call modal("export-item-modal", "Export CSV") %}

<form id="export-form">
  <div class="space-y-5">

    {# ==================== Templates ==================== #}
    <fieldset>

      <legend class="mb-2 text-sm font-medium text-zinc-300">
        Templates
      </legend>

      <div class="flex gap-2">
        <div class="relative min-w-0 flex-1">
          <label for="export-template-select" class="sr-only">
            Saved template
          </label>

          <select id="export-template-select" class="form-select">
            <option value="">No template selected</option>
          </select>

          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>
        </div>

        <button type="button" id="export-template-apply-button" disabled
          class="flex w-24 shrink-0 items-center justify-center gap-1 rounded-lg border border-zinc-700 px-3 py-2.5 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-zinc-700 disabled:hover:text-zinc-300">
          <i class="bi bi-play-fill" aria-hidden="true"></i>
          Apply
        </button>
      </div>

      <div class="mt-3 flex gap-2">
        <label for="export-template-name" class="sr-only">
          Template name
        </label>

        <input id="export-template-name" type="text" autocomplete="off"
          placeholder="Save current columns as template..."
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

        <button type="button" id="export-template-save-button"
          class="flex w-24 shrink-0 items-center justify-center gap-1 rounded-lg border border-zinc-700 px-3 py-2.5 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100">
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
          Save
        </button>
      </div>

      {% if is_current_user_admin() %}
      <label class="mt-2 flex items-center gap-2 text-xs text-zinc-400">
        <input id="export-template-shared" type="checkbox"
          class="size-4 rounded border-zinc-700 bg-zinc-900 text-zinc-100 focus:ring-zinc-500">
        Save as shared template (visible to all users)
      </label>
      {% endif %}

      <p id="export-template-error" class="mt-2 hidden text-xs text-red-400"></p>

    </fieldset>
    {# ==================== End Templates ==================== #}

    {# ==================== Columns ==================== #}
    <fieldset>

      <legend class="mb-2 text-sm font-medium text-zinc-300">
        Columns
      </legend>

      <p class="mb-3 text-xs text-zinc-500">
        Leave empty to include all fields.
      </p>

      <div id="export-column-rows" class="flex flex-wrap gap-2"></div>

      <div class="mt-3 flex gap-2">
        <label for="add-export-column" class="sr-only">
          Add column
        </label>

        <input id="add-export-column" name="add_export_column" type="text" autocomplete="off"
          list="export-column-options" placeholder="Add column..."
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

        <button type="button" id="add-export-column-button"
          class="flex shrink-0 items-center justify-center gap-1 rounded-lg border border-zinc-700 px-3 py-2.5 text-sm font-medium text-zinc-300 transition hover:border-zinc-500 hover:text-zinc-100">
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
          Add
        </button>
      </div>

      <datalist id="export-column-options"></datalist>

        <p id="add-export-column-error" class="mt-2 hidden text-xs text-red-400">
          Unknown or duplicate column. Pick one of the available fields.
        </p>

      <button type="button" id="export-columns-reset"
        class="mt-3 text-sm text-zinc-400 underline transition hover:text-zinc-200">
        Reset fields
      </button>

    </fieldset>
    {# ==================== End Columns ==================== #}


    {# ==================== Export Modal Actions ==================== #}
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

      <button type="button"
        class="modal-close rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="submit" id="export-submit-button"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-zinc-100">
        Export CSV
      </button>

    </div>
    {# ==================== End Export Modal Actions ==================== #}

  </div>
</form>
{% endcall %}
