{% extends "base.jinja" %}

{% block title %}Inventory{% endblock %}

{% block body %}

{# ==================== Inventory Page ==================== #}
<div class="min-h-screen bg-zinc-950 text-zinc-100">

  {# ==================== Header ==================== #}
  <header class="border-b border-zinc-800 bg-zinc-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

      <div>
        <h1 class="text-xl font-semibold tracking-tight">
          Inventory
        </h1>

        <p class="mt-1 text-sm text-zinc-400">
          Manage your inventory items.
        </p>
      </div>

      <div class="flex items-center gap-3">

        <span class="hidden text-sm text-zinc-400 sm:block">
          {{ username }}
        </span>

        {% if can_manage_users %}
        <a href="{{ url_for('admin.users') }}"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Users
        </a>
        {% endif %}

        {# Logout is intentionally POST #}
        <form method="post" action="{{ url_for('auth.logout') }}">
          <button type="submit"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Log out
          </button>
        </form>

      </div>
    </div>
  </header>
  {# ==================== End Header ==================== #}


  {# ==================== Inventory Content ==================== #}
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

    {# ==================== Search + Filter + Add Item ==================== #}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center">

      {# ==================== Search ==================== #}
      <form id="search-form" method="get" action="{{ url_for('main.index') }}" class="w-full sm:flex-1">

        <label for="search" class="sr-only">
          Search inventory
        </label>

        <input id="search" name="search" type="search" value="{{ search }}" placeholder="Search inventory..."
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

      </form>
      {# ==================== End Search ==================== #}


      {# ==================== Filter Button ==================== #}
      <button type="button" id="filter-item-button"
        class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100 sm:w-auto">

        <i class="bi bi-sliders mr-1" aria-hidden="true"></i>
        Filter

      </button>
      {# ==================== End Filter Button ==================== #}


      {# ==================== Add Item Button ==================== #}
      <button type="button" id="add-item-button"
        class="w-full rounded-lg bg-zinc-100 px-4 py-3 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950 sm:w-auto">

        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item

      </button>
      {# ==================== End Add Item Button ==================== #}

    </div>
    {# ==================== End Search + Filter + Add Item ==================== #}


    {# ==================== Inventory Items ==================== #}
    <section id="inventory-items">

      {# ==================== Inventory Loading State ==================== #}
      <div id="inventory-loading" class="hidden">
        <div class="flex min-h-48 items-center justify-center">
          <i class="bi bi-arrow-repeat animate-spin text-2xl text-zinc-500" aria-hidden="true"></i>

          <p class="ml-3 text-sm text-zinc-400">
            Loading inventory...
          </p>
        </div>
      </div>
      {# ==================== End Inventory Loading State ==================== #}


      {# ==================== Inventory Content ==================== #}
      <div id="inventory-content">
      </div>
      {# ==================== End Inventory Content ==================== #}

    </section>
    {# ==================== End Inventory Items ==================== #}

  </main>
</div>
{# ==================== End Inventory Page ==================== #}


{# ==================== Filter & Sort Modal ==================== #}
<div id="filter-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl backdrop:bg-black/60"> #}

  <form id="filter-item-form" method="get" action="{{ url_for('main.index') }}" class="p-6">

    {# Preserve the current search query when applying filters. #}
    <input type="hidden" name="search" value="{{ search }}">

    {# ==================== Filter Modal Header ==================== #}
    <div class="mb-6 flex items-center justify-between gap-4">

      <h2 class="text-lg font-semibold">
        Filter & Sort
      </h2>

      <button type="button" id="close-filter-item-modal"
        class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Close"
        aria-label="Close">

        <i class="bi bi-x-lg" aria-hidden="true"></i>

      </button>

    </div>
    {# ==================== End Filter Modal Header ==================== #}


    {# ==================== Include Archived Filter ==================== #}
    <fieldset>

      <label class="flex items-center gap-3 text-sm text-zinc-300">

        <input type="checkbox" name="include_archived" value="true" {% if include_archived %}checked{% endif %}
          class="h-4 w-4 rounded border-zinc-600 bg-zinc-800 text-zinc-100 focus:ring-zinc-500"
          id="filter-include-archived">

        Include Archived

      </label>

    </fieldset>
    {# ==================== End Include Archived Filter ==================== #}


    {# ==================== Location Filter ==================== #}
    <fieldset class="mt-6">

      <legend class="mb-3 text-sm font-medium text-zinc-300">
        Location
      </legend>

      <select id="filter-location" name="location_id"
        class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 text-sm text-zinc-100 focus:border-zinc-500 focus:outline-none">
        <option value="">&#60;All Locations&#62;</option>
        <option value="__none__">&#60;No location&#62;</option>
      </select>

    </fieldset>
    {# ==================== End Location Filter ==================== #}


    {# ==================== Sort Options ==================== #}
    <div class="mt-6">

      <label for="filter-sort-by" class="mb-2 block text-sm font-medium text-zinc-300">
        Sort by
      </label>

      <div class="relative">

        <select id="filter-sort-by" name="sort_by"
          class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

          <option value="name" {% if sort_by=="name" %} selected {% endif %}>
            Name
          </option>

        </select>

        <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
          aria-hidden="true"></i>

      </div>

    </div>
    {# ==================== End Sort Options ==================== #}


    {# ==================== Sort Order ==================== #}
    <fieldset class="mt-6">

      <legend class="mb-3 text-sm font-medium text-zinc-300">
        Order
      </legend>

      <div class="space-y-3">

        <label class="flex items-center gap-3 text-sm text-zinc-300">

          <input type="radio" name="sort_order" value="asc" {% if sort_order=="asc" %} checked {% endif %}
            class="h-4 w-4 border-zinc-600 bg-zinc-800 text-zinc-100 focus:ring-zinc-500">

          Ascending

        </label>

        <label class="flex items-center gap-3 text-sm text-zinc-300">

          <input type="radio" name="sort_order" value="desc" {% if sort_order=="desc" %} checked {% endif %}
            class="h-4 w-4 border-zinc-600 bg-zinc-800 text-zinc-100 focus:ring-zinc-500">

          Descending

        </label>

      </div>

    </fieldset>
    {# ==================== End Sort Order ==================== #}


    {# ==================== Filter Modal Actions ==================== #}
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

      <button type="button" id="clear-filter-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Clear
      </button>

      <button type="submit"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
        Apply
      </button>

    </div>
    {# ==================== End Filter Modal Actions ==================== #}

  </form>

</div>
{# ==================== End Filter & Sort Modal ==================== #}


{# ==================== Add Item Modal ==================== #}
<div id="add-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl backdrop:bg-black/60"> #}

  <form method="post" action="{{ url_for('inventory.create') }}" class="p-6">

    {# ==================== Add Item Header ==================== #}
    <div class="mb-6 flex items-start justify-between gap-4">

      <div>
        <h2 class="text-lg font-semibold">
          Add item
        </h2>

        <p class="mt-1 text-sm text-zinc-400">
          Add a new item to the inventory.
        </p>
      </div>

      <button type="button" id="close-add-item-modal"
        class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" aria-label="Close">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>

    </div>
    {# ==================== End Add Item Header ==================== #}


    {# ==================== Add Item Fields ==================== #}
    <div class="space-y-5">

      {# Item Name #}
      <div>
        <label for="item-name" class="mb-2 block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="item-name" name="name" type="text" required
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
      </div>

      {# Item Location #}
      <div>
        <label for="item-location" class="mb-2 block text-sm font-medium text-zinc-300">
          Location
        </label>

        <div class="relative">

          <select id="item-location" name="location_id"
            class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

            <option value="">
              —
            </option>

          </select>

          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>

        </div>
      </div>

    </div>
    {# ==================== End Add Item Fields ==================== #}


    {# ==================== Add Item Actions ==================== #}
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

      <button type="button" id="cancel-add-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="submit"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-900">
        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item
      </button>

    </div>
    {# ==================== End Add Item Actions ==================== #}

  </form>

</div>
{# ==================== End Add Item Modal ==================== #}


{# ==================== Edit Asset Modal ==================== #}
<div id="edit-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl backdrop:bg-black/60"> #}

  {# ==================== Edit Loading State ==================== #}
  <div id="edit-item-loading" class="p-6">

    <div class="flex min-h-48 flex-col items-center justify-center">

      <i class="bi bi-arrow-repeat animate-spin text-2xl text-zinc-500" aria-hidden="true"></i>

      <p class="mt-3 text-sm text-zinc-400">
        Loading asset...
      </p>

    </div>

  </div>
  {# ==================== End Edit Loading State ==================== #}


  {# ==================== Edit Asset Form ==================== #}
  <form id="edit-item-form" method="post" class="hidden p-6">

    {# ==================== Edit Asset Header ==================== #}
    <div class="mb-4 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">

      {# Asset ID #}
      <p id="edit-item-id" class="min-w-0 truncate font-mono text-sm text-zinc-500">
      </p>

      {# Header Actions #}
      <div class="flex shrink-0 gap-1">

        {# Save Changes #}
        <button type="submit" class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
          title="Save changes" aria-label="Save changes">
          <i class="bi bi-floppy" aria-hidden="true"></i>
        </button>

        {# Archive Asset #}
        <button type="button" id="archive-item-button"
          class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300" title="Archive asset"
          aria-label="Archive asset">
          <i class="bi bi-archive" aria-hidden="true"></i>
        </button>

        {# Close Modal #}
        <button type="button" id="close-edit-item-modal"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Close"
          aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

      </div>
      {# ==================== End Header Actions ==================== #}

    </div>
    {# ==================== End Edit Asset Header ==================== #}


    {# ==================== Edit Asset Fields ==================== #}
    <div class="overflow-hidden rounded-lg border border-zinc-800">

      <table class="w-full text-left text-sm">

        <tbody class="divide-y divide-zinc-800">

          {# Name #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Name
            </th>

            <td class="px-4 py-3">
              <input id="edit-item-name" name="name" type="text" required
                class="block w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
            </td>
          </tr>

          {# Location #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Location
            </th>

            <td class="px-4 py-3">

              <div class="relative">

                <select id="edit-item-location" name="location_id"
                  class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

                  <option value="">
                    —
                  </option>

                </select>

                <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
                  aria-hidden="true"></i>

              </div>

            </td>
          </tr>

        </tbody>

      </table>

    </div>
    {# ==================== End Edit Asset Fields ==================== #}

  </form>
  {# ==================== End Edit Asset Form ==================== #}

</div>
{# ==================== End Edit Asset Modal ==================== #}


{# ==================== Archive Confirmation Modal ==================== #}
<div id="archive-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl"> #}

  <div class="p-6">

    {# ==================== Archive Confirmation Header ==================== #}
    <div class="flex items-start gap-4">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
        <i class="bi bi-archive" aria-hidden="true"></i>
      </div>

      <div>
        <h2 class="text-lg font-semibold">
          Archive asset?
        </h2>

        <p class="mt-1 text-sm text-zinc-400">
          This will remove the asset from the active inventory.
          You can restore it later.
        </p>
      </div>

    </div>
    {# ==================== End Archive Confirmation Header ==================== #}


    {# ==================== Archive Confirmation Actions ==================== #}
    <div class="mt-6 flex justify-end gap-3">

      <button type="button" id="cancel-archive-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="button" id="confirm-archive-item"
        class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
        <i class="bi bi-archive mr-1" aria-hidden="true"></i>
        Archive asset
      </button>

    </div>
    {# ==================== End Archive Confirmation Actions ==================== #}

  </div>

</div>
{# ==================== End Archive Confirmation Modal ==================== #}

{# ==================== Restore Confirmation Modal ==================== #}
<div id="restore-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl"> #}

  <div class="p-6">

    {# ==================== Restore Confirmation Header ==================== #}
    <div class="flex items-start gap-4">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-zinc-800 text-zinc-300">
        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
      </div>

      <div>
        <h2 class="text-lg font-semibold">
          Restore asset?
        </h2>

        <p class="mt-1 text-sm text-zinc-400">
          This will return the asset to the active inventory.
        </p>
      </div>

    </div>
    {# ==================== End Restore Confirmation Header ==================== #}


    {# ==================== Restore Confirmation Actions ==================== #}
    <div class="mt-6 flex justify-end gap-3">

      <button type="button" id="cancel-restore-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="button" id="confirm-restore-item"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
        <i class="bi bi-arrow-counterclockwise mr-1" aria-hidden="true"></i>
        Restore asset
      </button>

    </div>
    {# ==================== End Restore Confirmation Actions ==================== #}

  </div>

</div>
{# ==================== End Restore Confirmation Modal ==================== #}

{# ==================== View Asset Modal ==================== #}
<div id="view-item-modal" class="hidden">
  {# class="hidden m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100
  shadow-2xl backdrop:bg-black/60"> #}

  {# ==================== View Loading State ==================== #}
  <div id="view-item-loading" class="p-6">

    <div class="flex min-h-48 flex-col items-center justify-center">

      <i class="bi bi-arrow-repeat animate-spin text-2xl text-zinc-500" aria-hidden="true"></i>

      <p class="mt-3 text-sm text-zinc-400">
        Loading asset...
      </p>

    </div>

  </div>
  {# ==================== End View Loading State ==================== #}


  {# ==================== View Asset Content ==================== #}
  <div id="view-item-content" class="hidden p-6">

    {# ==================== Asset Header ==================== #}
    <div class="mb-4 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">

      {# Asset ID #}
      <div class="min-w-0">
        <p id="view-item-id" class="truncate font-mono text-sm text-zinc-500">
        </p>

        <span id="view-item-archived" class="mt-1 hidden rounded bg-zinc-700 px-2 py-0.5 text-xs text-zinc-300">
          Archived
        </span>
      </div>

      {# Header Actions #}
      <div class="flex shrink-0 gap-1">

        {# Copy Asset ID #}
        <button type="button" id="view-item-copy"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Copy ID"
          aria-label="Copy ID">
          <i class="bi bi-copy" aria-hidden="true"></i>
        </button>

        {# ==================== Dynamic Edit/Restore ==================== #}
        <button type="button" id="view-item-restore"
          class="hidden rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
          title="Restore asset" aria-label="Restore asset">
          <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
        </button>

        <button type="button" id="view-item-edit"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Edit asset"
          aria-label="Edit asset">
          <i class="bi bi-pencil" aria-hidden="true"></i>
        </button>
        {# ==================== End Dynamic Edit/Restore ==================== #}

        {# Close Modal #}
        <button type="button" id="close-view-item-modal"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Close"
          aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

      </div>
      {# ==================== End Header Actions ==================== #}

    </div>
    {# ==================== End Asset Header ==================== #}


    {# ==================== Asset Details ==================== #}
    <div class="overflow-hidden rounded-lg border border-zinc-800">

      <table class="w-full text-left text-sm">

        <tbody class="divide-y divide-zinc-800">

          {# Name #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Name
            </th>

            <td id="view-item-name" class="truncate px-4 py-3 text-zinc-100">
            </td>
          </tr>

          {# Location #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Location
            </th>

            <td id="view-item-location" class="px-4 py-3 text-zinc-100">
            </td>
          </tr>

        </tbody>

      </table>

    </div>
    {# ==================== End Asset Details ==================== #}

  </div>
  {# ==================== End View Asset Content ==================== #}

</div>
{# ==================== End View Asset Modal ==================== #}

{# ==================== Modal Manager ==================== #}
<dialog id="modal-manager"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">
  <div id="modal-manager-content"></div>
</dialog>
{# ==================== End Modal Manager ==================== #}

{% endblock %}
{# ==================== End Body Block ==================== #}


{% block scripts %}
<script src="{{ url_for('static', filename='js/inventory.js') }}"></script>
{% endblock %}
{# ==================== End Scripts Block ==================== #}
