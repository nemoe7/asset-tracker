{% extends "base.jinja" %}

{% block title %}Inventory{% endblock %}

{% block body %}

{# ==================== Inventory Page ==================== #}
<div class="min-h-screen bg-zinc-950 text-zinc-100">

  {# ==================== Header ==================== #}
  <header class="border-b border-zinc-800 bg-zinc-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

      <div>
        <h1 class="text-xl font-semibold tracking-tight">
          Inventory
        </h1>

        <p class="mt-1 text-sm text-zinc-400">
          Manage your inventory items.
        </p>
      </div>

      <div class="flex items-center gap-3">

        <span class="hidden text-sm text-zinc-400 sm:block">
          {{ username }}
        </span>

        {% if can_manage_users %}
        <a href="{{ url_for('admin.users') }}"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Users
        </a>
        {% endif %}

        {# ==================== QR Scanner Button ==================== #}
        <button type="button" id="qr-scanner-button"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          <i class="bi bi-qr-code-scan mr-1" aria-hidden="true"></i>
          Scan
        </button>
        {# ==================== End QR Scanner Button ==================== #}


        {# Logout is intentionally POST #}
        <form method="post" action="{{ url_for('auth.logout') }}">
          <button type="submit"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Log out
          </button>
        </form>

      </div>
    </div>
  </header>
  {# ==================== End Header ==================== #}


  {# ==================== Inventory Content ==================== #}
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

    {# ==================== Search + Filter + Add Item ==================== #}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center">

      {# ==================== Search ==================== #}
      <form id="search-form" method="get" action="{{ url_for('main.index') }}" class="w-full sm:flex-1">

        <label for="search" class="sr-only">
          Search inventory
        </label>

        <input id="search" name="search" type="search" value="{{ search }}" placeholder="Search inventory..."
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

      </form>
      {# ==================== End Search ==================== #}


      {# ==================== Filter Button ==================== #}
      <button type="button" id="filter-item-button"
        class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100 sm:w-auto">

        <i class="bi bi-sliders mr-1" aria-hidden="true"></i>
        Filter

      </button>
      {# ==================== End Filter Button ==================== #}


      {# ==================== Add Item Button ==================== #}
      <button type="button" id="add-item-button"
        class="w-full rounded-lg bg-zinc-100 px-4 py-3 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950 sm:w-auto">

        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item

      </button>
      {# ==================== End Add Item Button ==================== #}

    </div>
    {# ==================== End Search + Filter + Add Item ==================== #}


    {# ==================== Inventory Items ==================== #}
    <section id="inventory-items">

      {# ==================== Inventory Loading State ==================== #}
      <div id="inventory-loading" class="hidden">
        <div class="flex min-h-48 items-center justify-center">
          <span class="size-5 animate-spin rounded-full border-2 border-zinc-700 border-t-zinc-400" aria-hidden="true">
          </span>

          <p class="ml-3 text-sm text-zinc-400">
            Loading inventory...
          </p>
        </div>
      </div>
      {# ==================== End Inventory Loading State ==================== #}


      {# ==================== Inventory Content ==================== #}
      <div id="inventory-content">
      </div>
      {# ==================== End Inventory Content ==================== #}

    </section>
    {# ==================== End Inventory Items ==================== #}

  </main>
</div>
{# ==================== End Inventory Page ==================== #}

{% include "inventory/modals/filter_item.jinja" %}
{% include "inventory/modals/add_item.jinja" %}
{% include "inventory/modals/edit_item.jinja" %}
{% include "inventory/modals/view_item.jinja" %}
{% include "inventory/modals/qr_scanner.jinja" %}
{% include "inventory/modals/archive_item.jinja" %}
{% include "inventory/modals/restore_item.jinja" %}
{% endblock %}
{# ==================== End Body Block ==================== #}


{% block scripts %}
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script src="{{ url_for('static', filename='js/inventory.js') }}"></script>
{% endblock %}
{# ==================== End Scripts Block ==================== #}
