{% extends "base.jinja" %}

{% block title %}Inventory{% endblock %}

{% block body %}

{# ==================== Inventory Page ==================== #}
<div class="min-h-screen bg-zinc-950 text-zinc-100">

  {# ==================== Header ==================== #}
  <header class="border-b border-zinc-800 bg-zinc-900">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">

      <div>
        <h1 class="text-xl font-semibold tracking-tight">
          Inventory
        </h1>

        <p class="mt-1 text-sm text-zinc-400">
          Manage your inventory items.
        </p>
      </div>

      <div class="flex items-center gap-3">

        <span class="hidden text-sm text-zinc-400 sm:block">
          {{ username }}
        </span>

        {% if can_manage_users %}
        <a href="{{ url_for('admin.users') }}"
          class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
          Users
        </a>
        {% endif %}

        {# Logout is intentionally POST #}
        <form method="post" action="{{ url_for('auth.logout') }}">
          <button type="submit"
            class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
            Log out
          </button>
        </form>

      </div>
    </div>
  </header>
  {# ==================== End Header ==================== #}


  {# ==================== Inventory Content ==================== #}
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

    {# ==================== Search + Add Item ==================== #}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center">

      <form method="get" action="{{ url_for('main.index') }}" class="w-full sm:flex-1">
        <label for="search" class="sr-only">
          Search inventory
        </label>

        <input id="search" name="search" type="search" value="{{ search }}" placeholder="Search inventory..."
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
      </form>

      <button type="button" id="add-item-button"
        class="w-full rounded-lg bg-zinc-100 px-4 py-3 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950 sm:w-auto">
        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item
      </button>

    </div>
    {# ==================== End Search + Add Item ==================== #}


    {# ==================== Inventory Items ==================== #}
    {% if items %}

    <section class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900">

      {# ==================== Desktop Inventory Table ==================== #}
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-left text-sm">

          <thead class="border-b border-zinc-800">
            <tr>

              <th class="px-5 py-3 font-medium text-zinc-400">
                Name
              </th>

              <th class="px-5 py-3 font-medium text-zinc-400">
                Location
              </th>

              <th class="w-px whitespace-nowrap px-5 py-3 text-center font-medium text-zinc-400">
                Actions
              </th>

            </tr>
          </thead>

          <tbody class="divide-y divide-zinc-800">

            {% for item in items %}

            {# Entire row opens View Asset. Action buttons are excluded in JS. #}
            <tr class="view-item cursor-pointer transition hover:bg-zinc-800/60" data-item-id="{{ item['id'] }}">

              <td class="px-5 py-4 font-medium text-zinc-100">
                {{ item["name"] }}
              </td>

              <td class="px-5 py-4 text-zinc-400">
                {{ item["location_name"] or "No location" }}
              </td>

              {# ==================== Item Actions ==================== #}
              <td class="px-5 py-4">
                <div class="flex justify-end gap-1">

                  {# Copy Asset ID #}
                  <button type="button"
                    class="copy-item-id rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                    data-item-id="{{ item['id'] }}" title="Copy ID" aria-label="Copy ID">
                    <i class="bi bi-copy" aria-hidden="true"></i>
                  </button>

                  {# Edit Asset #}
                  <button type="button"
                    class="edit-item rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                    data-item-id="{{ item['id'] }}" title="Edit asset" aria-label="Edit asset">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                  </button>

                </div>
              </td>
              {# ==================== End Item Actions ==================== #}

            </tr>

            {% endfor %}

          </tbody>
        </table>
      </div>
      {# ==================== End Desktop Inventory Table ==================== #}


      {# ==================== Mobile Inventory Cards ==================== #}
      <div class="divide-y divide-zinc-800 md:hidden">

        {% for item in items %}

        {# Entire card opens View Asset. #}
        <article class="view-item cursor-pointer p-4 transition hover:bg-zinc-800/60" data-item-id="{{ item['id'] }}">

          <div class="flex items-start justify-between gap-4">

            <div class="min-w-0">
              <h2 class="truncate font-medium text-zinc-100">
                {{ item["name"] }}
              </h2>

              <p class="mt-1 text-sm text-zinc-400">
                {{ item["location_name"] or "No location" }}
              </p>
            </div>

            {# ==================== Mobile Item Actions ==================== #}
            <div class="flex shrink-0 gap-1">

              {# Copy Asset ID #}
              <button type="button"
                class="copy-item-id rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                data-item-id="{{ item['id'] }}" title="Copy ID" aria-label="Copy ID">
                <i class="bi bi-copy" aria-hidden="true"></i>
              </button>

              {# Edit Asset #}
              <button type="button"
                class="edit-item rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
                data-item-id="{{ item['id'] }}" title="Edit asset" aria-label="Edit asset">
                <i class="bi bi-pencil" aria-hidden="true"></i>
              </button>

            </div>
            {# ==================== End Mobile Item Actions ==================== #}

          </div>
        </article>

        {% endfor %}

      </div>
      {# ==================== End Mobile Inventory Cards ==================== #}

    </section>

    {% else %}

    {# ==================== Empty Inventory State ==================== #}
    <section class="rounded-xl border border-dashed border-zinc-800 bg-zinc-900/50 px-6 py-16 text-center">

      <i class="bi bi-box-seam text-3xl text-zinc-600" aria-hidden="true"></i>

      <h2 class="mt-4 text-lg font-medium text-zinc-200">
        No inventory items
      </h2>

      {% if search %}

      <p class="mt-2 text-sm text-zinc-400">
        No items match "{{ search }}".
      </p>

      {% else %}

      <p class="mt-2 text-sm text-zinc-400">
        Add your first inventory item to get started.
      </p>

      {% endif %}

      <button type="button" id="empty-add-item-button"
        class="mt-6 rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300">
        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item
      </button>

    </section>
    {# ==================== End Empty Inventory State ==================== #}

    {% endif %}

  </main>
</div>
{# ==================== End Inventory Page ==================== #}


{# ==================== Add Item Modal ==================== #}
<dialog id="add-item-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">

  <form method="post" action="{{ url_for('inventory.create') }}" class="p-6">

    {# ==================== Add Item Header ==================== #}
    <div class="mb-6 flex items-start justify-between gap-4">

      <div>
        <h2 class="text-lg font-semibold">
          Add item
        </h2>

        <p class="mt-1 text-sm text-zinc-400">
          Add a new item to the inventory.
        </p>
      </div>

      <button type="button" id="close-add-item-modal"
        class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" aria-label="Close">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>

    </div>
    {# ==================== End Add Item Header ==================== #}


    {# ==================== Add Item Fields ==================== #}
    <div class="space-y-5">

      {# Item Name #}
      <div>
        <label for="item-name" class="mb-2 block text-sm font-medium text-zinc-300">
          Name
        </label>

        <input id="item-name" name="name" type="text" required
          class="block w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
      </div>

      {# Item Location #}
      <div>
        <label for="item-location" class="mb-2 block text-sm font-medium text-zinc-300">
          Location
        </label>

        <div class="relative">

          <select id="item-location" name="location_id"
            class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2.5 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

            <option value="">
              No location
            </option>

            {% for location in locations %}
            <option value="{{ location['id'] }}">
              {{ location['name'] }}
            </option>
            {% endfor %}

          </select>

          <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
            aria-hidden="true"></i>

        </div>
      </div>

    </div>
    {# ==================== End Add Item Fields ==================== #}


    {# ==================== Add Item Actions ==================== #}
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

      <button type="button" id="cancel-add-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="submit"
        class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-zinc-300 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-900">
        <i class="bi bi-plus-lg mr-1" aria-hidden="true"></i>
        Add item
      </button>

    </div>
    {# ==================== End Add Item Actions ==================== #}

  </form>

</dialog>
{# ==================== End Add Item Modal ==================== #}


{# ==================== Edit Asset Modal ==================== #}
<dialog id="edit-item-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">

  {# ==================== Edit Loading State ==================== #}
  <div id="edit-item-loading" class="p-6">

    <div class="flex min-h-48 flex-col items-center justify-center">

      <i class="bi bi-arrow-repeat animate-spin text-2xl text-zinc-500" aria-hidden="true"></i>

      <p class="mt-3 text-sm text-zinc-400">
        Loading asset...
      </p>

    </div>

  </div>
  {# ==================== End Edit Loading State ==================== #}


  {# ==================== Edit Asset Form ==================== #}
  <form id="edit-item-form" method="post" class="hidden p-6">

    {# ==================== Edit Asset Header ==================== #}
    <div class="mb-4 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">

      {# Asset ID #}
      <p id="edit-item-id" class="min-w-0 truncate font-mono text-sm text-zinc-500">
      </p>

      {# Header Actions #}
      <div class="flex shrink-0 gap-1">

        {# Save Changes #}
        <button type="submit" class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100"
          title="Save changes" aria-label="Save changes">
          <i class="bi bi-floppy" aria-hidden="true"></i>
        </button>

        {# Archive Asset #}
        <button type="button" id="archive-item-button"
          class="rounded-lg p-2 text-red-400 transition hover:bg-red-950 hover:text-red-300" title="Archive asset"
          aria-label="Archive asset">
          <i class="bi bi-archive" aria-hidden="true"></i>
        </button>

        {# Close Modal #}
        <button type="button" id="close-edit-item-modal"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Close"
          aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

      </div>
      {# ==================== End Header Actions ==================== #}

    </div>
    {# ==================== End Edit Asset Header ==================== #}


    {# ==================== Edit Asset Fields ==================== #}
    <div class="overflow-hidden rounded-lg border border-zinc-800">

      <table class="w-full text-left text-sm">

        <tbody class="divide-y divide-zinc-800">

          {# Name #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Name
            </th>

            <td class="px-4 py-3">
              <input id="edit-item-name" name="name" type="text" required
                class="block w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-500 focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">
            </td>
          </tr>

          {# Location #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Location
            </th>

            <td class="px-4 py-3">

              <div class="relative">

                <select id="edit-item-location" name="location_id"
                  class="block w-full appearance-none rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 pr-10 text-sm text-zinc-100 outline-none transition focus:border-zinc-500 focus:ring-2 focus:ring-zinc-700">

                  <option value="">
                    No location
                  </option>

                  {% for location in locations %}
                  <option value="{{ location['id'] }}">
                    {{ location['name'] }}
                  </option>
                  {% endfor %}

                </select>

                <i class="bi bi-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"
                  aria-hidden="true"></i>

              </div>

            </td>
          </tr>

        </tbody>

      </table>

    </div>
    {# ==================== End Edit Asset Fields ==================== #}

  </form>
  {# ==================== End Edit Asset Form ==================== #}

</dialog>
{# ==================== End Edit Asset Modal ==================== #}

{# ==================== Archive Confirmation Modal ==================== #}
<dialog id="archive-item-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100 shadow-2xl">

  <div class="p-6">

    {# ==================== Archive Confirmation Header ==================== #}
    <div class="flex items-start gap-4">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-950 text-red-400">
        <i class="bi bi-archive" aria-hidden="true"></i>
      </div>

      <div>
        <h2 class="text-lg font-semibold">
          Archive asset?
        </h2>

        <p class="mt-1 text-sm text-zinc-400">
          This will remove the asset from the active inventory.
          You can restore it later.
        </p>
      </div>

    </div>
    {# ==================== End Archive Confirmation Header ==================== #}


    {# ==================== Archive Confirmation Actions ==================== #}
    <div class="mt-6 flex justify-end gap-3">

      <button type="button" id="cancel-archive-item"
        class="rounded-lg border border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-zinc-100">
        Cancel
      </button>

      <button type="button" id="confirm-archive-item"
        class="rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500">
        <i class="bi bi-archive mr-1" aria-hidden="true"></i>
        Archive asset
      </button>

    </div>
    {# ==================== End Archive Confirmation Actions ==================== #}

  </div>

</dialog>
{# ==================== End Archive Confirmation Modal ==================== #}

{# ==================== View Asset Modal ==================== #}
<dialog id="view-item-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-800 bg-zinc-900 p-0 text-zinc-100 shadow-2xl backdrop:bg-black/60">

  {# ==================== View Loading State ==================== #}
  <div id="view-item-loading" class="p-6">

    <div class="flex min-h-48 flex-col items-center justify-center">

      <i class="bi bi-arrow-repeat animate-spin text-2xl text-zinc-500" aria-hidden="true"></i>

      <p class="mt-3 text-sm text-zinc-400">
        Loading asset...
      </p>

    </div>

  </div>
  {# ==================== End View Loading State ==================== #}


  {# ==================== View Asset Content ==================== #}
  <div id="view-item-content" class="hidden p-6">

    {# ==================== Asset Header ==================== #}
    <div class="mb-4 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">

      {# Asset ID #}
      <p id="view-item-id" class="min-w-0 truncate font-mono text-sm text-zinc-500">
      </p>

      {# Header Actions #}
      <div class="flex shrink-0 gap-1">

        {# Copy Asset ID #}
        <button type="button" id="view-item-copy"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Copy ID"
          aria-label="Copy ID">
          <i class="bi bi-copy" aria-hidden="true"></i>
        </button>

        {# Edit Asset #}
        <button type="button" id="view-item-edit"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Edit asset"
          aria-label="Edit asset">
          <i class="bi bi-pencil" aria-hidden="true"></i>
        </button>

        {# Close Modal #}
        <button type="button" id="close-view-item-modal"
          class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-zinc-100" title="Close"
          aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

      </div>
      {# ==================== End Header Actions ==================== #}

    </div>
    {# ==================== End Asset Header ==================== #}


    {# ==================== Asset Details ==================== #}
    <div class="overflow-hidden rounded-lg border border-zinc-800">

      <table class="w-full text-left text-sm">

        <tbody class="divide-y divide-zinc-800">

          {# Name #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Name
            </th>

            <td id="view-item-name" class="px-4 py-3 text-zinc-100">
            </td>
          </tr>

          {# Location #}
          <tr>
            <th class="w-1/3 px-4 py-3 font-medium text-zinc-400">
              Location
            </th>

            <td id="view-item-location" class="px-4 py-3 text-zinc-100">
            </td>
          </tr>

        </tbody>

      </table>

    </div>
    {# ==================== End Asset Details ==================== #}

  </div>
  {# ==================== End View Asset Content ==================== #}

</dialog>
{# ==================== End View Asset Modal ==================== #}

{% endblock %}
{# ==================== End Body Block ==================== #}


{% block scripts %}
<script src="{{ url_for('static', filename='js/inventory.js') }}"></script>
{% endblock %}
{# ==================== End Scripts Block ==================== #}
