<tr class="hover:bg-zinc-700/40">
  <td class="min-w-0 px-4 py-3 font-medium text-zinc-100">
    <div class="line-clamp-2 break-words [overflow-wrap:anywhere]">
      {{ item.name }}
    </div>
  </td>

  <td class="w-64 min-w-0 px-4 py-3 text-zinc-300">
    <div class="line-clamp-2 break-words [overflow-wrap:anywhere]">
      {{ item.location_name or "—" }}
    </div>
  </td>

  <td class="w-40 whitespace-nowrap px-4 py-3 text-zinc-400">
    {{ item.updated_at|datetime }}
  </td>

  <td class="w-24 whitespace-nowrap px-4 py-3">
    <div class="flex justify-center gap-1">
      <button type="button" title="Copy ID" onclick="copyItemId('{{ item.id }}', this)"
        class="rounded-lg p-2 text-zinc-500 hover:bg-zinc-700 hover:text-zinc-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 8m0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2z" />
          <path d="M16 8v-2a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
        </svg>
      </button>

      <button type="button" title="Edit item" onclick="openEditItem('{{ item.id }}')"
        class="rounded-lg p-2 text-zinc-500 hover:bg-zinc-700 hover:text-zinc-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 7h-1a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1" />
          <path d="M20.385 6.585a2.1 2.1 0 0 0-2.97-2.97l-8.415 8.415v3h3z" />
          <path d="M16 5l3 3" />
        </svg>
      </button>
    </div>
  </td>
</tr>
